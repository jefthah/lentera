        }
        Text {
            text: root.entry.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: root.current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.entry.detail;
            color: Theme.text-3;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 0;
