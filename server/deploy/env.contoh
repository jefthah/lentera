# Rahasia server Lentera. Salin ke .env di folder ini lalu isi:
#   cp env.contoh .env && chmod 600 .env
# .env tidak boleh di-commit atau dikirim lewat chat.

# Kata sandi PostgreSQL di dalam Docker. Hanya huruf dan angka, karena dipakai
# di DATABASE_URL. Buat dengan: openssl rand -hex 24
# Hanya berlaku saat database pertama kali dibuat; mengganti nilai ini nanti
# tidak mengganti kata sandi database yang sudah ada.
POSTGRES_PASSWORD=

# Rahasia HMAC kode masuk, minimal 32 karakter. Buat dengan: openssl rand -hex 32
LOGIN_CODE_SECRET=

# Kunci API Resend, diisi sendiri oleh pemilik akun Resend.
RESEND_API_KEY=
# Pengirim email kode. Domainnya harus sudah diverifikasi di Resend.
MAIL_FROM="Lentera <masuk@example.org>"

# Port API di host (hanya 127.0.0.1). Ganti bila 8310 sudah dipakai, dan
# samakan dengan reverse_proxy di lentera.caddy.
LENTERA_PORT=8310
