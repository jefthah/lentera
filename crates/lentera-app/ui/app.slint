}

component Swatch inherits VerticalLayout {
    in property <int> index;
    in property <bool> on;
    callback clicked();
    spacing: 4px;
    Rectangle {
        height: 30px;
        border-radius: 9px;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? Theme.accent : #3A4150;
        accessible-role: button;
        accessible-label: "Latar " + Theme.slide-names[root.index];
        accessible-checked: root.on;
        accessible-action-default => {
            root.clicked();
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 6px;
            background: Theme.slide-bg[root.index];
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    Text {
        text: Theme.slide-names[root.index];
        color: root.on ? Theme.text : Theme.text-3;
        font-size: 12px;
        horizontal-alignment: center;
    }
}

// Pilihan "Gambar" di samping warna latar: gambar yang sedang dipakai, atau
// ikon gambar bila belum ada.
component PictureSwatch inherits VerticalLayout {
    in property <image> picture;
    in property <bool> on;
    callback clicked();
    spacing: 4px;
    Rectangle {
        height: 30px;
        border-radius: 9px;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? Theme.accent : #3A4150;
        accessible-role: button;
        accessible-label: "Latar gambar";
        accessible-checked: root.on;
        accessible-action-default => {
            root.clicked();
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 6px;
            clip: true;
            background: Theme.raised;
            if root.on: Image {
                width: parent.width;
                height: parent.height;
                source: root.picture;
                image-fit: cover;
            }
            if !root.on: Icon {
                svg: Icons.image;
                color: Theme.text-2;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    Text {
        text: "Gambar";
        color: root.on ? Theme.text : Theme.text-3;
        font-size: 12px;
        horizontal-alignment: center;
    }
}

component BackgroundThumb inherits Rectangle {
    in property <BackgroundTile> tile;
    callback clicked();
    callback remove();
    height: self.width * 9 / 16 + 24px;
    frame := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.width * 9 / 16;
        border-radius: 10px;
        border-width: root.tile.on ? 2px : 1px;
        border-color: root.tile.on ? Theme.accent : touch.has-hover ? #4A5263 : #2A303C;
        accessible-role: button;
        accessible-label: (root.tile.video ? "Latar video " : "Latar ") + root.tile.label;
        accessible-checked: root.tile.on;
        accessible-action-default => {
            root.clicked();
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 7px;
            clip: true;
            background: #000000;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.tile.picture;
                image-fit: cover;
            }
            // Penanda video di pojok kiri bawah.
            if root.tile.video: Rectangle {
                x: 6px;
                y: parent.height - self.height - 6px;
                height: 20px;
                width: video-row.preferred-width + 12px;
                border-radius: 5px;
                background: #000000B3;
                video-row := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            svg: Icons.play;
                            color: #FFFFFF;
                            filled: true;
                            width: 10px;
                            height: 10px;
                        }
                    }
                    Text {
                        text: "Video";
                        color: #FFFFFF;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
        IconBtn {
            x: parent.width - self.width - 6px;
            y: 6px;
            size: 28px;
            icon: Icons.trash;
            label: (root.tile.video ? "Hapus latar video " : "Hapus latar ") + root.tile.label;
            clicked => {
                root.remove();
            }
        }
    }
    Text {
        x: 2px;
        y: frame.height + 5px;
        width: parent.width - 4px;
        text: root.tile.label;
        color: root.tile.on ? Theme.text : Theme.text-3;
        font-size: 12px;
        overflow: elide;
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> detail;
    padding-left: 6px;
    padding-right: 6px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        text: root.detail;
        color: Theme.text-3;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// Lingkaran berisi huruf pertama nama profil.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <int> tone;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Theme.avatar[root.tone];
    Text {
        width: parent.width;
        height: parent.height;
        text: root.initial;
        color: Theme.on-accent;
        font-size: root.size * 0.44;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Tombol profil di bilah atas; membuka layar pilih profil.
component ProfileChip inherits Rectangle {
    in property <string> name;
    in property <string> initial;
    in property <int> tone;
    // Hanya lingkaran dan panah, untuk jendela sempit.
    in property <bool> compact;
    callback clicked();
    height: 40px;
    max-width: 220px;
    preferred-width: chip-row.preferred-width;
    border-radius: 12px;
    background: touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border : transparent;
    accessible-role: button;
    accessible-label: "Profil " + root.name + ". Ganti profil";
    accessible-action-default => {
        root.clicked();
    }
    chip-row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Avatar {
                initial: root.initial;
                tone: root.tone;
                size: 28px;
            }
        }
        if !root.compact: Text {
            horizontal-stretch: 1;
            text: root.name;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                svg: Icons.chevron;
                color: Theme.text-3;
                width: 14px;
                height: 14px;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Status sinkron akun di bilah atas. Klik membuka menu akun (`account-menu`
// di MainWindow).
component AccountChip inherits Rectangle {
    // 0 tersinkron, 1 menyinkron, 2 offline atau menunggu, 3 perlu tindakan.
    in property <int> state;
    in property <string> label;
    // Hanya ikon, untuk jendela sempit.
    in property <bool> compact;
    callback clicked();
    height: 40px;
    preferred-width: row.preferred-width;
    border-radius: 12px;
    background: touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border : transparent;
    accessible-role: button;
    accessible-label: "Akun dan sinkron: " + root.label;
    accessible-action-default => {
        root.clicked();
    }
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 22px;
                Icon {
                    svg: Icons.cloud;
                    color: Theme.text-2;
                    width: 22px;
                    height: 22px;
                }
                Rectangle {
                    x: 14px;
                    y: 12px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    border-width: 2px;
                    border-color: Theme.bar;
                    background: root.state == 0 ? Theme.ok : root.state == 1 ? Theme.verse : root.state == 2 ? Theme.text-3 : Theme.accent;
                }
            }
        }
        if !root.compact: Text {
            text: root.label;
            color: root.state == 3 ? Theme.accent : Theme.text-2;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ProfileCardView inherits Rectangle {
    in property <ProfileCard> card;
    callback clicked();
    callback rename();
    callback remove();
    border-radius: 16px;
    background: touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : Theme.raised;
    border-width: root.card.current ? 2px : 1px;
    border-color: root.card.current ? Theme.accent : touch.has-hover ? Theme.active-border : Theme.border;
    accessible-role: button;
    accessible-label: "Buka profil " + root.card.name;
    accessible-action-default => {
        root.clicked();
    }
    // Di bawah tombol ganti nama dan hapus, supaya klik keduanya tidak membuka profil.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding: 16px;
        padding-top: 22px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Avatar {
                initial: root.card.initial;
                tone: root.card.tone;
                size: 68px;
            }
        }
        Text {
            height: 42px;
            text: root.card.name;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        Text {
            text: root.card.detail;
            color: root.card.current ? Theme.accent : Theme.text-3;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            IconBtn {
                icon: Icons.edit;
                label: "Ganti nama profil " + root.card.name;
                size: 32px;
                bordered: false;
                clicked => {
                    root.rename();
                }
            }
            if !root.card.current: IconBtn {
                icon: Icons.trash;
                label: "Hapus profil " + root.card.name;
                size: 32px;
                bordered: false;
                tint: Theme.danger;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

component NewProfileCard inherits Rectangle {
    callback clicked();
    border-radius: 16px;
    background: touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: "Profil baru";
    accessible-action-default => {
        root.clicked();
    }
    VerticalLayout {
        padding: 16px;
        padding-top: 22px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 68px;
                height: 68px;
                border-radius: 34px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border;
                Icon {
                    svg: Icons.plus;
                    color: Theme.accent;
                    width: 26px;
                    height: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        Text {
            text: "Profil baru";
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "Mulai dari pustaka kosong";
            color: Theme.text-3;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Layar pilih profil: menutupi seluruh jendela operator. Juga dipakai untuk
// membuat profil baru dan mengganti nama profil.
component ProfileScreen inherits Rectangle {
    in property <[ProfileCard]> profiles;
    in property <string> current-name;
    // 0: daftar profil, 1: profil baru, 2: ganti nama.
    in-out property <int> form;
    in-out property <string> form-name;
    in-out property <string> form-target;
    in-out property <string> form-error;
    callback choose(string);
    callback close();
    callback submit();
    callback remove(string);
    background: Theme.bg;

    // Menahan klik supaya tidak sampai ke layar operator di belakangnya.
    TouchArea { }

    VerticalLayout {
        padding: 28px;
        padding-bottom: 32px;
        spacing: 22px;
        HorizontalLayout {
            alignment: end;
            IconBtn {
                icon: Icons.close;
                label: "Tutup pilihan profil";
                size: 40px;
                clicked => {
                    root.close();
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../assets/icon/lentera.svg");
                    width: 56px;
                    height: 56px;
                }
            }
            Text {
                text: root.form == 1 ? "Profil baru" : root.form == 2 ? "Ganti nama profil" : "Pilih profil";
                color: Theme.text;
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.form == 1
                    ? "Profil baru dimulai dengan pustaka kosong. Latar dan monitor proyektor mengikuti yang sekarang."
                    : root.form == 2 ? "Nama ini tampil di bilah atas dan di daftar profil."
                    : "Setiap profil punya pustaka lirik, ayat, dan susunan ibadahnya sendiri.";
                color: Theme.text-2;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if root.form == 0: cards := ScrollView {
            vertical-stretch: 1;
            property <length> card-w: 190px;
            property <length> card-h: 224px;
            property <length> gap: 18px;
            property <int> count: root.profiles.length + 1;
            property <int> cols: Math.max(1, Math.min(self.count, Math.floor((self.visible-width + self.gap) / (self.card-w + self.gap))));
            property <length> left: Math.max(0px, (self.visible-width - (self.cols * (self.card-w + self.gap) - self.gap)) / 2);
            content-width: self.visible-width;
            content-height: Math.ceil(self.count / self.cols) * (self.card-h + self.gap);
            for card[i] in root.profiles: ProfileCardView {
                x: cards.left + Math.mod(i, cards.cols) * (cards.card-w + cards.gap);
                y: Math.floor(i / cards.cols) * (cards.card-h + cards.gap);
                width: cards.card-w;
                height: cards.card-h;
                card: card;
                clicked => {
                    root.choose(card.id);
                }
                rename => {
                    root.form-target = card.id;
                    root.form-name = card.name;
                    root.form-error = "";
                    root.form = 2;
                }
                remove => {
                    root.remove(card.id);
                }
            }
            NewProfileCard {
                x: cards.left + Math.mod(root.profiles.length, cards.cols) * (cards.card-w + cards.gap);
                y: Math.floor(root.profiles.length / cards.cols) * (cards.card-h + cards.gap);
                width: cards.card-w;
                height: cards.card-h;
                clicked => {
                    root.form-target = "";
                    root.form-name = "";
                    root.form-error = "";
                    root.form = 1;
                }
            }
        }
        if root.form != 0: HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;
            VerticalLayout {
                width: 420px;
                alignment: start;
                spacing: 10px;
                Text {
                    text: "Nama profil";
                    color: Theme.text-2;
                    font-size: 13px;
                }
                LineEdit {
                    placeholder-text: "Misalnya: Ibadah Umum, Komisi Pemuda";
                    text <=> root.form-name;
                    init => {
                        self.focus();
                    }
                    accepted => {
                        root.submit();
                    }
                }
                if root.form-error != "": Text {
                    text: root.form-error;
                    color: Theme.danger;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 6px;
                    Btn {
                        text: "Batal";
                        kind: "ghost";
                        clicked => {
                            root.form = 0;
                        }
                    }
                    Btn {
                        text: root.form == 1 ? "Buat dan buka" : "Simpan nama";
                        icon: Icons.check;
                        kind: "primary";
                        clicked => {
                            root.submit();
                        }
                    }
                }
            }
        }
        if root.form == 0: Text {
            text: "Sedang dibuka: " + root.current-name + "  ·  Esc untuk kembali";
            color: Theme.text-3;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    in property <string> version;

    in property <[LibraryRow]> library;
    in property <[ServiceRow]> service;
    in property <[SlideTile]> slides;
    in property <int> selected-id: -1;
    in property <int> selected-service: -1;

    in property <bool> has-current;
    in property <string> current-title;
    // Jumlah slide, atau "belum di pustaka" untuk ayat dari tab Alkitab.
    in property <string> current-meta;
    in property <bool> current-song: true;
    in property <int> preview-page;
    in property <bool> has-preview;
    in property <SlideTile> preview;
    in property <string> preview-meta;
    // "Slide 4 · Judul", di samping layar pratinjau kecil.
    in property <string> preview-title;

    in property <bool> has-live;
    in property <SlideTile> live;
    in property <string> live-meta: "Belum ada yang tayang";
    in property <string> live-title;
    in property <int> live-total;
    // Jenis dan latar materi yang tayang, misalnya "Lirik · latar Gelap".
    in property <string> live-caption;
    in property <int> live-item-id: -1;
    in property <int> live-page: -1;
    in property <int> live-service: -1;
    in property <bool> blackout;
    in property <bool> output-visible;
    in property <bool> fullscreen;
    // Latar umum: warna (bg-index) atau gambar.
    in property <int> bg-index;
    in property <image> bg-picture;
    in property <bool> has-bg-picture;
    // Video latar bisa ditambahkan di sistem ini (belum di macOS).
    in property <bool> video-supported;
    // Gambar latar materi terpilih (slide, pratinjau, editor) dan materi yang
    // tayang: gambar sendiri materi itu, atau latar umum.
    in property <image> view-picture;
    in property <bool> has-view-picture;
    in property <image> live-picture;
    in property <bool> has-live-picture;
    // Nama gambar latar sendiri materi terpilih; kosong = latar umum.
    in property <string> current-background;
    // Daftar gambar latar profil. Galeri dibuka untuk satu materi
    // (bg-for-item) atau untuk latar umum.
    in property <[BackgroundTile]> backgrounds;
    in property <bool> bg-for-item;
    in property <string> bg-item-title;
    in property <bool> bg-item-own;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    // Monitor proyektor yang dipilih, misalnya "Monitor 2".
    in property <string> projector-label;

    in-out property <string> query;
    in-out property <int> filter;
    // Jumlah materi di daftar pustaka (setelah dicari dan disaring), di tab Pustaka.
    in property <string> library-count;
    // Kolom kiri: 0 Pustaka, 1 Alkitab, 2 Susunan. Tab Susunan hanya ada di
    // jendela sempit; di jendela lebar susunan selalu tampil di atas.
    in-out property <int> left-tab;

    // Tab Alkitab.
    in property <[string]> bible-translations;
    in-out property <int> bible-translation;
    in-out property <string> bible-ref;
    in property <string> bible-label;
    in property <string> bible-detail;
    in property <string> bible-error;
    in property <bool> bible-has-passage;
    in property <string> bible-chapter-title;
    in property <[VerseRow]> bible-verses;
    in-out property <bool> bible-one-per-slide;
    // Daftar ayat digulir ke baris ini setiap kali serial berubah.
    in property <int> bible-scroll-row;
    in property <int> bible-scroll-serial;
    in property <bool> bible-importing;
    in property <string> bible-import-info;
    in-out property <string> bible-import-code;
    in-out property <string> bible-import-name;
    in property <string> bible-import-error;
    // "Terakhir dibuka" di tab Alkitab.
    in property <[HistoryRow]> bible-history;
    // Kolom tengah menampilkan Alkitab, bukan slide materi terpilih.
    in property <bool> bible-view;
    // Ada ayat yang tampil di tengah, juga saat referensi yang sedang
    // diketik belum dikenal (bible-has-passage false).
    in property <bool> bible-showing;
    // Tombol pasal sebelumnya / berikutnya; 0 bila tidak ada.
    in property <int> bible-prev-chapter;
    in property <int> bible-next-chapter;
    // Kotak referensi di tengah meminta fokus begitu tampil.
    in-out property <bool> bible-focus;
    // Tulisan baku referensi bila isi kotak cari berupa referensi Alkitab.
    in property <string> query-reference;

    in property <bool> editing;
    in property <bool> focus-title;
    in-out property <string> editor-title;
    in-out property <string> editor-body;
    in property <bool> editor-song: true;
    in property <[SlideTile]> editor-slides;
    // Ada perubahan editor yang belum tersimpan (disimpan otomatis sebentar lagi).
    in property <bool> editor-dirty;

    in property <string> status: "Tersimpan otomatis";
    in property <bool> status-ok: true;
    in property <string> update-version;

    // Profil yang sedang dibuka dan layar pilih profil.
    in property <string> profile-name;
    in property <string> profile-initial;
    in property <int> profile-tone;
    in property <[ProfileCard]> profiles;
    in property <bool> picking-profile;
    in-out property <int> profile-form;
    in-out property <string> profile-form-name;
    in-out property <string> profile-form-target;
    in-out property <string> profile-form-error;

    // Akun dan sinkron. Tombol akun hanya tampil bila sync-label terisi
    // (Lentera memakai server); email kosong bila belum masuk.
    in property <string> account-email;
    // 0 tersinkron, 1 menyinkron, 2 offline atau menunggu, 3 perlu tindakan.
    in property <int> sync-state;
    in property <string> sync-label;
    in property <string> sync-detail;
    in property <bool> sync-login;
    // Tepi kiri menu akun: tepi kiri tombol akun.
    property <length> account-menu-x;

    callback search-changed();
    callback search-accepted();
    callback filter-changed(int);
    callback select-library(int);
    callback activate-library(int);
    callback add-to-service(int);
    callback select-service(int);
    callback activate-service(int);
    callback move-service(int, int);
    callback remove-service(int);
    callback select-slide(int);
    callback activate-slide(int);
    callback go-live();
    callback navigate(bool);
    callback toggle-blackout();
    callback toggle-fullscreen();
    callback toggle-projector();
    callback projector-menu-opened();
    callback escape();
    callback monitor-changed(int);
    callback background-changed(int);
    callback show-backgrounds();
    callback show-item-backgrounds();
    callback use-general-background();
    callback pick-background(string);
    callback add-backgrounds();
    callback remove-background(string);
    callback new-item();
    callback edit-current();
    callback close-editor();
    callback editor-edited();
    callback set-song(bool);
    callback add-current-to-service();
    callback delete-current();
    callback save-now();
    callback import-lyrics();
    callback import-easyworship();
    callback import-verses();
    callback update-now();
    callback show-profiles();
    callback close-profiles();
    callback choose-profile(string);
    callback submit-profile-form();
    callback delete-profile(string);
    callback sync-now();
    callback sign-in-again();
    callback sign-out();
    callback left-tab-changed(int);
    callback bible-translation-changed(int);
    callback bible-ref-edited();
    callback bible-go-live();
    callback bible-verse-clicked(int, bool);
    callback bible-verse-activated(int);
    callback bible-add-to-service();
    callback bible-packing-changed();
    callback bible-import();
    callback bible-import-save();
    callback bible-import-cancel();
    callback bible-remove-translation();
    callback bible-history-clicked(int);
    callback bible-chapter(int);

    // Jendela sempit (di bawah 1200 px, misalnya laptop 1024×640): tombol
    // profil dan impor diringkas, kolom kiri dan kanan lebih sempit, susunan
    // ibadah pindah ke tab sendiri, dan latar umum hanya ada di menu
    // proyektor. Diisi lewat `changed`, bukan binding, karena lebar jendela
    // ikut ditentukan isi tata letak.
    property <bool> compact-bar;
    // Lebar kolom kanan di jendela lebar: 28% lebar jendela, 340–400 px.
    property <length> side-width: 380px;
    changed width => {
        self.set-compact(self.width < 1200px);
        self.side-width = Math.min(400px, Math.max(340px, self.width * 0.28));
    }
    function set-compact(compact: bool) {
        if compact == self.compact-bar {
            return;
        }
        self.compact-bar = compact;
        // Tab Susunan hanya ada di jendela sempit.
        if !compact && self.left-tab == 2 {
            self.left-tab = 0;
        }
    }
    // Fokus kembali ke pintasan papan ketik saat layar profil dibuka, ditutup,
    // atau formulirnya selesai.
    changed picking-profile => {
        keys.focus();
    }
    changed profile-form => {
        if self.profile-form == 0 {
            keys.focus();
        }
    }

    public function close-about() {
        about-popup.close();
    }
    public function show-about() {
        about-popup.show();
    }

    public function open-backgrounds() {
        bg-popup.show();
    }
    public function close-backgrounds() {
        bg-popup.close();
    }
    public function show-import-menu() {
        import-menu.show();
    }

    public function close-import-menu() {
        import-menu.close();
    }

    title: "Lentera " + root.version + (root.profile-name == "" ? "" : " · " + root.profile-name);
    preferred-width: 1360px;
    preferred-height: 840px;
    min-width: 1024px;
    min-height: 640px;
    background: Theme.bg;
    default-font-size: 14px;

    init => {
        self.compact-bar = self.width < 1200px;
        self.side-width = Math.min(400px, Math.max(340px, self.width * 0.28));
        if self.compact-bar && self.left-tab == 0 {
            self.left-tab = 2;
        }
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if root.picking-profile {
                if event.text == Key.Escape {
                    root.escape();
                    return accept;
                }
                return reject;
            }
            if event.text == Key.F5 || (event.modifiers.control && event.text == Key.Return) {
                root.go-live();
                return accept;
            }
            if event.text == Key.F6 {
                root.toggle-blackout();
                return accept;
            }
            if event.text == Key.F11 {
                root.toggle-fullscreen();
                return accept;
            }
            if event.text == Key.PageDown {
                root.navigate(true);
                return accept;
            }
            if event.text == Key.PageUp {
                root.navigate(false);
                return accept;
            }
            if event.text == Key.Escape {
                // Dari kotak teks (misalnya kotak cari): hanya keluar dari
                // kotak itu, layar penuh dan proyektor tidak berubah.
                if !self.has-focus {
                    self.focus();
                    return accept;
                }
                root.escape();
                return accept;
            }
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                search.focus-input();
                return accept;
            }
            // 1–9: langsung menayangkan slide itu dari materi terpilih.
            if self.has-focus && !event.modifiers.control && !event.modifiers.alt && event.text.is-float() {
                if event.text.to-float() >= 1 && event.text.to-float() <= 9 && event.text.to-float() <= root.slides.length && !root.editing {
                    root.activate-slide(event.text.to-float() - 1);
                    return accept;
                }
            }
            if event.modifiers.control && (event.text == "s" || event.text == "S") {
                root.save-now();
                return accept;
            }
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                root.new-item();
                return accept;
            }
            if self.has-focus && (event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == " ") {
                root.navigate(true);
                return accept;
            }
            if self.has-focus && (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.navigate(false);
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Bilah atas.
            Rectangle {
                height: 60px;
                background: Theme.bar;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        horizontal-stretch: 0;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icon/lentera.svg");
                                width: 32px;
                                height: 32px;
                            }
                        }
                        Text {
                            text: "Lentera";
                            color: Theme.text;
                            font-size: 17px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 1px;
                            height: 24px;
                            background: Theme.line;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        ProfileChip {
                            compact: root.compact-bar;
                            name: root.profile-name;
                            initial: root.profile-initial;
                            tone: root.profile-tone;
                            clicked => {
                                root.show-profiles();
                            }
                        }
                    }
                    if root.sync-label != "": VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        AccountChip {
                            compact: root.compact-bar;
                            state: root.sync-state;
                            label: root.sync-label;
                            clicked => {
                                root.account-menu-x = self.absolute-position.x;
                                account-menu.show();
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 6;
                        min-width: 200px;
                        max-width: 520px;
                        search := SearchBox {
                            placeholder: root.compact-bar ? "Cari, atau ketik Yoh 3:16" : "Cari lagu atau ayat, atau ketik referensi: Yoh 3:16";
                            text <=> root.query;
                            edited => {
                                root.search-changed();
                            }
                            accepted => {
                                root.search-accepted();
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        VerticalLayout {
                            alignment: center;
                            projector-btn := ProjectorButton {
                                on: root.output-visible;
                                monitor: root.projector-label;
                                compact: root.compact-bar;
                                toggle => {
                                    root.toggle-projector();
                                    keys.focus();
                                }
                                menu => {
                                    root.projector-menu-opened();
                                    projector-menu.show();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            if !root.compact-bar: Btn {
                                text: "Impor";
                                full-text: true;
                                icon: Icons.import;
                                height: 40px;
                                clicked => {
                                    import-menu.show();
                                }
                            }
                            if root.compact-bar: IconBtn {
                                icon: Icons.import;
                                label: "Impor";
                                size: 40px;
                                clicked => {
                                    import-menu.show();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                icon: Icons.info;
                                label: "Tentang Lentera";
                                size: 40px;
                                clicked => {
                                    about-popup.show();
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
                // Menu akun: email, keadaan sinkron, sinkron sekarang, keluar.
                account-menu := PopupWindow {
                    x: Math.max(8px, Math.min(root.account-menu-x, root.width - self.width - 8px));
                    y: parent.height - 4px;
                    width: 300px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: Theme.raised;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: root.account-email != "" ? "Masuk sebagai" : "Belum masuk ke akun";
                                color: Theme.text-3;
                                font-size: 12px;
                            }
                            if root.account-email != "": Text {
                                text: root.account-email;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: root.sync-detail;
                                color: root.sync-state == 3 ? Theme.accent : Theme.text-2;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 9px;
                                Rectangle {
                                    y: 4px;
                                    height: 1px;
                                    background: Theme.line;
                                }
                            }
                            // Baris menu tidak dibuat dengan `if`: baris kondisional
                            // di PopupWindow tidak menerima klik.
                            MenuRow {
                                text: !root.sync-login ? "Sinkron sekarang" : root.account-email != "" ? "Masuk lagi" : "Masuk";
                                hint: root.sync-login ? "Data di komputer ini tetap dipakai" : "Otomatis setiap 30 detik";
                                clicked => {
                                    account-menu.close();
                                    if root.sync-login {
                                        root.sign-in-again();
                                    } else {
                                        root.sync-now();
                                    }
                                }
                            }
                            MenuRow {
                                visible: root.account-email != "";
                                height: self.visible ? 48px : 0px;
                                text: "Keluar dari akun";
                                hint: "Lentera ditutup; data tetap di komputer ini";
                                clicked => {
                                    account-menu.close();
                                    root.sign-out();
                                }
                            }
                        }
                    }
                }
                // Menu proyektor: monitor, latar umum, dan buka/tutup proyektor.
                projector-menu := PopupWindow {
                    // Rata kanan dengan tombol proyektor (di kiri tombol Impor dan Tentang).
                    x: Math.max(8px, root.width - self.width - (root.compact-bar ? 112px : 166px));
                    y: parent.height - 4px;
                    width: 300px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: Theme.raised;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: "Monitor proyektor";
                                color: Theme.text-2;
                                font-size: 12px;
                            }
                            for label[i] in root.monitors: CheckRow {
                                text: label;
                                on: i == root.monitor-index;
                                clicked => {
                                    root.monitor-index = i;
                                    root.monitor-changed(i);
                                }
                            }
                            if root.monitors.length == 0: Text {
                                text: "Monitor tidak terbaca.";
                                color: Theme.text-3;
                                font-size: 12px;
                            }
                            Rectangle {
                                height: 9px;
                                Rectangle {
                                    y: 4px;
                                    height: 1px;
                                    background: Theme.line;
                                }
                            }
                            Text {
                                text: "Latar umum";
                                color: Theme.text-2;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                for name[i] in Theme.slide-names: Swatch {
                                    index: i;
                                    on: i == root.bg-index && !root.has-bg-picture;
                                    clicked => {
                                        root.background-changed(i);
                                    }
                                }
                                PictureSwatch {
                                    picture: root.bg-picture;
                                    on: root.has-bg-picture;
                                    clicked => {
                                        projector-menu.close();
                                        root.show-backgrounds();
                                    }
                                }
                            }
                            Rectangle {
                                height: 9px;
                                Rectangle {
                                    y: 4px;
                                    height: 1px;
                                    background: Theme.line;
                                }
                            }
                            Btn {
                                text: root.output-visible ? "Tutup proyektor" : "Buka proyektor";
                                icon: Icons.monitor;
                                kind: root.output-visible ? "danger" : "primary";
                                height: 40px;
                                font-size: 13px;
                                clicked => {
                                    projector-menu.close();
                                    root.toggle-projector();
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
                import-menu := PopupWindow {
                    x: parent.width - 312px;
                    y: parent.height - 4px;
                    width: 264px;
                    Rectangle {
                        background: Theme.raised;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            MenuRow {
                                text: "Lirik lagu (.txt)";
                                hint: "Baris kosong memisahkan slide";
                                clicked => {
                                    import-menu.close();
                                    root.import-lyrics();
                                }
                            }
                            MenuRow {
                                text: "Lagu dari EasyWorship";
                                hint: "Semua lagu sekaligus, EW 2009 sampai 8";
                                clicked => {
                                    import-menu.close();
                                    root.import-easyworship();
                                }
                            }
                            MenuRow {
                                text: "Ayat Alkitab (.tsv)";
                                hint: "referensi [TAB] teks, UTF-8";
                                clicked => {
                                    import-menu.close();
                                    root.import-verses();
                                }
                            }
                            MenuRow {
                                text: "Alkitab lengkap";
                                hint: "OpenSong, Zefania, TSV, EasyWorship";
                                clicked => {
                                    import-menu.close();
                                    root.bible-import();
                                }
                            }
                        }
                    }
                }
                // Tentang Lentera. Widget AboutSlint wajib tampil di sini sebagai
                // atribusi lisensi Slint Royalty-free 2.0.
                about-popup := PopupWindow {
                    x: (parent.width - 460px) / 2;
                    y: 96px;
                    width: 460px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: Theme.raised;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icon/lentera.svg");
                                        width: 52px;
                                        height: 52px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Lentera";
                                        color: Theme.text;
                                        font-size: 20px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Versi " + root.version;
                                        color: Theme.text-3;
                                        font-size: 13px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    IconBtn {
                                        icon: Icons.close;
                                        label: "Tutup";
                                        size: 32px;
                                        bordered: false;
                                        clicked => {
                                            about-popup.close();
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "Presentasi ibadah yang ringan untuk Windows dan macOS. Kode sumber berlisensi MIT di github.com/jefthah/lentera.";
                                color: Theme.text-2;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Komponen pihak ketiga dan lisensinya tercantum di THIRD-PARTY-NOTICES.txt di folder program.";
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }
                            AboutSlint { }
                        }
                    }
                }
                // Daftar gambar latar profil.
                bg-popup := PopupWindow {
                    x: (parent.width - self.width) / 2;
                    y: 72px;
                    width: Math.min(640px, root.width - 48px);
                    height: Math.min(560px, root.height - 120px);
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: Theme.raised;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: root.bg-for-item ? "Latar materi" : "Latar umum";
                                        color: Theme.text;
                                        font-size: 18px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: root.bg-for-item ? root.bg-item-title : root.backgrounds.length == 0 ? "Belum ada latar di profil ini" : root.backgrounds.length + " latar di profil ini";
                                        color: Theme.text-3;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                if root.bg-for-item && root.bg-item-own: VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Btn {
                                        text: "Pakai latar umum";
                                        font-size: 13px;
                                        full-text: true;
                                        clicked => {
                                            root.use-general-background();
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Btn {
                                        text: root.video-supported ? "Tambah gambar atau video" : "Tambah gambar";
                                        icon: Icons.plus;
                                        font-size: 13px;
                                        full-text: true;
                                        clicked => {
                                            root.add-backgrounds();
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        icon: Icons.close;
                                        label: "Tutup";
                                        size: 32px;
                                        bordered: false;
                                        clicked => {
                                            bg-popup.close();
                                        }
                                    }
                                }
                            }
                            Text {
                                text: (root.bg-for-item
                                    ? "Klik latar untuk memakainya hanya di materi ini; materi lain tetap memakai latar umum. "
                                    : "Klik latar untuk memakainya sebagai latar umum, yaitu latar materi yang tidak punya latar sendiri. ")
                                    + (root.video-supported
                                    ? "Gambar JPG atau PNG dan video MP4, MOV, atau WMV disalin ke profil ini; berkas aslinya tidak diubah. Video diputar berulang tanpa suara di proyektor."
                                    : "Gambar JPG atau PNG disalin ke profil ini; berkas aslinya tidak diubah.");
                                color: Theme.text-2;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            if root.backgrounds.length == 0: Rectangle {
                                vertical-stretch: 1;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border;
                                Text {
                                    x: 24px;
                                    width: parent.width - 48px;
                                    text: root.video-supported
                                        ? "Klik Tambah gambar atau video untuk memilih satu atau beberapa berkas sekaligus, misalnya dari folder gambar atau video EasyWorship."
                                        : "Klik Tambah gambar untuk memilih satu atau beberapa gambar sekaligus, misalnya dari folder gambar EasyWorship.";
                                    color: Theme.text-3;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                            if root.backgrounds.length > 0: gallery := ScrollView {
                                vertical-stretch: 1;
                                property <int> cols: 4;
                                property <length> tile-w: (self.visible-width - (self.cols - 1) * 12px) / self.cols;
                                property <length> tile-h: self.tile-w * 9 / 16 + 24px;
                                content-width: self.visible-width;
                                content-height: Math.ceil(root.backgrounds.length / self.cols) * (self.tile-h + 12px);
                                for tile[i] in root.backgrounds: BackgroundThumb {
                                    x: Math.mod(i, gallery.cols) * (gallery.tile-w + 12px);
                                    y: Math.floor(i / gallery.cols) * (gallery.tile-h + 12px);
                                    width: gallery.tile-w;
                                    tile: tile;
                                    clicked => {
                                        root.pick-background(tile.name);
                                    }
                                    remove => {
                                        root.remove-background(tile.name);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                // Kolom kiri: susunan ibadah, pustaka, dan Alkitab. Di jendela
                // sempit susunan ibadah pindah ke tab sendiri.
                Rectangle {
                    width: root.compact-bar ? 248px : 304px;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 12px;
                        padding-top: 16px;
                        spacing: 8px;
                        if !root.compact-bar: SectionTitle {
                            text: "Susunan ibadah";
                            detail: root.service.length + " materi";
                        }
                        if root.compact-bar: Rectangle {
                            height: 38px;
                            border-radius: 10px;
                            background: Theme.bg;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 2px;
                                SegTab {
                                    text: "Susunan";
                                    count: root.service.length;
                                    on: root.left-tab == 2;
                                    clicked => {
                                        root.left-tab = 2;
                                        root.left-tab-changed(2);
                                    }
                                }
                                SegTab {
                                    text: "Pustaka";
                                    on: root.left-tab == 0;
                                    clicked => {
                                        root.left-tab = 0;
                                        root.left-tab-changed(0);
                                    }
                                }
                                SegTab {
                                    text: "Alkitab";
                                    on: root.left-tab == 1;
                                    clicked => {
                                        root.bible-focus = true;
                                        root.left-tab = 1;
                                        root.left-tab-changed(1);
                                    }
                                }
                            }
                        }
                        if (!root.compact-bar || root.left-tab == 2) && root.service.length == 0: Text {
                            text: "Belum ada materi. Tekan + Susunan di pustaka untuk menambahkan.";
                            color: Theme.text-3;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if !root.compact-bar || root.left-tab == 2: ListView {
                            vertical-stretch: 1.4;
                            min-height: 120px;
                            for row[i] in root.service: ServiceRowView {
                                entry: row;
                                index: i;
                                selected: i == root.selected-service;
                                on-air: i == root.live-service && !root.blackout;
                                compact: root.compact-bar;
                                done: root.live-service >= 0 && i < root.live-service;
                                live-detail: root.compact-bar
                                    ? "Tayang · slide " + (root.live-page + 1) + "/" + root.live-total
                                    : (row.song ? "Lirik" : "Ayat") + " · slide " + (root.live-page + 1) + " dari " + root.live-total;
                                clicked => {
                                    keys.focus();
                                    root.select-service(i);
                                }
                                activated => {
                                    root.activate-service(i);
                                }
                                up => {
                                    root.move-service(i, -1);
                                }
                                down => {
                                    root.move-service(i, 1);
                                }
                                remove => {
                                    root.remove-service(i);
                                }
                            }
                        }
                        if !root.compact-bar: Rectangle {
                            height: 1px;
                            background: Theme.line;
                        }
                        if !root.compact-bar: Rectangle {
                            height: 38px;
                            border-radius: 10px;
                            background: Theme.bg;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 2px;
                                SegTab {
                                    text: "Pustaka";
                                    icon: Icons.music;
                                    count: root.left-tab == 0 ? root.library-count : "";
                                    on: root.left-tab == 0;
                                    clicked => {
                                        root.left-tab = 0;
                                        root.left-tab-changed(0);
                                    }
                                }
                                SegTab {
                                    text: "Alkitab";
                                    icon: Icons.book;
                                    on: root.left-tab == 1;
                                    clicked => {
                                        root.bible-focus = true;
                                        root.left-tab = 1;
                                        root.left-tab-changed(1);
                                    }
                                }
                            }
                        }
                        if root.left-tab == 0: HorizontalLayout {
                            spacing: 6px;
                            Chip {
                                text: "Semua";
                                pad: root.compact-bar ? 10px : 13px;
                                on: root.filter == 0;
                                clicked => {
                                    root.filter = 0;
                                    root.filter-changed(0);
                                }
                            }
                            Chip {
                                text: "Lagu";
                                pad: root.compact-bar ? 10px : 13px;
                                on: root.filter == 1;
                                clicked => {
                                    root.filter = 1;
                                    root.filter-changed(1);
                                }
                            }
                            Chip {
                                text: "Ayat";
                                pad: root.compact-bar ? 10px : 13px;
                                on: root.filter == 2;
                                clicked => {
                                    root.filter = 2;
                                    root.filter-changed(2);
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            if !root.compact-bar: Btn {
                                text: "Baru";
                                icon: Icons.plus;
                                kind: "ghost";
                                full-text: true;
                                height: 32px;
                                font-size: 13px;
                                pad: 8px;
                                clicked => {
                                    root.new-item();
                                }
                            }
                            if root.compact-bar: IconBtn {
                                icon: Icons.plus;
                                label: "Materi baru";
                                size: 32px;
                                bordered: false;
                                clicked => {
                                    root.new-item();
                                }
                            }
                        }
                        // Isi kotak cari berupa referensi: buka di Alkitab.
                        if root.left-tab == 0 && root.query-reference != "": Rectangle {
                            height: 42px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #2A3B5C;
                            background: ref-touch.has-hover ? #1B2B45 : Theme.verse-soft;
                            accessible-role: button;
                            accessible-label: "Buka " + root.query-reference + " di Alkitab";
                            accessible-action-default => {
                                root.search-accepted();
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        svg: Icons.book;
                                        color: Theme.verse;
                                        width: 16px;
                                        height: 16px;
                                    }
                                }
                                Text {
                                    text: "Buka " + root.query-reference;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Kbd {
                                        text: "Enter";
                                    }
                                }
                            }
                            ref-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.search-accepted();
                                }
                            }
                        }
                        if root.left-tab == 0 && root.library.length == 0 && root.query-reference == "": Text {
                            text: root.query == "" ? "Pustaka masih kosong." : "Tidak ada yang cocok dengan pencarian.";
                            color: Theme.text-3;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.left-tab == 0: ListView {
                            vertical-stretch: 1;
                            min-height: 150px;
                            for row in root.library: LibraryRowView {
                                entry: row;
                                compact: root.compact-bar;
                                selected: row.id == root.selected-id;
                                clicked => {
                                    keys.focus();
                                    root.select-library(row.id);
                                }
                                activated => {
                                    root.activate-library(row.id);
                                }
                                add => {
                                    root.add-to-service(row.id);
                                }
                            }
                        }
                        // Tab Alkitab: formulir impor.
                        if root.left-tab == 1 && root.bible-importing: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;
                            padding-left: 4px;
                            padding-right: 4px;
                            Text {
                                text: "Impor Alkitab";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.bible-import-info;
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Singkatan, ditulis di judul ayat";
                                color: Theme.text-2;
                                font-size: 12px;
                            }
                            LineEdit {
                                placeholder-text: "misalnya TB";
                                text <=> root.bible-import-code;
                                accepted => {
                                    root.bible-import-save();
                                }
                            }
                            Text {
                                text: "Nama terjemahan";
                                color: Theme.text-2;
                                font-size: 12px;
                            }
                            LineEdit {
                                placeholder-text: "misalnya Terjemahan Baru";
                                text <=> root.bible-import-name;
                                accepted => {
                                    root.bible-import-save();
                                }
                            }
                            if root.bible-import-error != "": Text {
                                text: root.bible-import-error;
                                color: Theme.danger;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Gunakan hanya terjemahan yang Anda berhak pakai.";
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Btn {
                                    text: "Batal";
                                    kind: "ghost";
                                    height: 38px;
                                    font-size: 13px;
                                    clicked => {
                                        root.bible-import-cancel();
                                    }
                                }
                                Btn {
                                    text: "Simpan";
                                    icon: Icons.check;
                                    kind: "primary";
                                    height: 38px;
                                    font-size: 13px;
                                    clicked => {
                                        root.bible-import-save();
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                            }
                        }
                        // Tab Alkitab: terjemahan, "Terakhir dibuka", dan impor.
                        // Referensi diketik dan ayat dipilih di kolom tengah.
                        if root.left-tab == 1 && !root.bible-importing: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;
                            if root.bible-translations.length > 0: HorizontalLayout {
                                spacing: 6px;
                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: root.bible-translations;
                                    current-index <=> root.bible-translation;
                                    selected => {
                                        root.bible-translation-changed(self.current-index);
                                    }
                                }
                                IconBtn {
                                    icon: Icons.trash;
                                    label: "Hapus terjemahan ini";
                                    clicked => {
                                        root.bible-remove-translation();
                                    }
                                }
                            }
                            if root.bible-translations.length == 0: Text {
                                text: "Belum ada Alkitab di komputer ini. Impor sekali, lalu cukup ketik referensi di kolom tengah.";
                                color: Theme.text-3;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            if root.bible-translations.length > 0: Text {
                                text: "Terakhir dibuka";
                                color: Theme.text-3;
                                font-size: 12px;
                            }
                            if root.bible-translations.length > 0 && root.bible-history.length == 0: Text {
                                text: "Ayat yang ditayangkan atau ditambahkan ke susunan muncul di sini.";
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            if root.bible-translations.length > 0: ListView {
                                vertical-stretch: 1;
                                min-height: 60px;
                                for row[i] in root.bible-history: HistoryRowView {
                                    entry: row;
                                    current: root.bible-view && row.label == root.bible-label;
                                    clicked => {
                                        root.bible-history-clicked(i);
                                    }
                                }
                            }
                            if root.bible-translations.length == 0: Rectangle {
                                vertical-stretch: 1;
                            }
                            Rectangle {
                                height: 42px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: import-touch.has-hover ? Theme.hover : Theme.raised;
                                accessible-role: button;
                                accessible-label: "Impor terjemahan";
                                accessible-action-default => {
                                    root.bible-import();
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            svg: Icons.import;
                                            color: Theme.text-2;
                                            width: 16px;
                                            height: 16px;
                                        }
                                    }
                                    Text {
                                        text: "Impor terjemahan";
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.bible-translations.length + " terpasang";
                                        color: Theme.text-3;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                }
                                import-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.bible-import();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                }

                // Tengah, Alkitab: ketik referensi, pilih ayat, lihat hasil slide.
                if !root.editing && root.bible-view: VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 20px;
                    padding-bottom: 14px;
                    if root.bible-translations.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 10px;
                        Text {
                            text: root.bible-importing ? "Lengkapi impor di kolom kiri" : "Belum ada Alkitab di komputer ini";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.bible-importing
                                ? "Periksa singkatan dan nama terjemahan, lalu tekan Simpan."
                                : "Impor sekali dari berkas OpenSong XML, Zefania XML, TSV, atau EasyWorship yang Anda berhak gunakan. Setelah itu cukup ketik referensi, misalnya Yoh 3:16-18.";
                            color: Theme.text-3;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        if !root.bible-importing: HorizontalLayout {
                            alignment: center;
                            Btn {
                                text: "Impor Alkitab";
                                icon: Icons.import;
                                full-text: true;
                                height: 40px;
                                font-size: 13px;
                                clicked => {
                                    root.bible-import();
                                }
                            }
                        }
                    }
                    if root.bible-translations.length > 0: RefBox {
                        text <=> root.bible-ref;
                        compact: root.compact-bar;
                        property <bool> want-focus: root.bible-focus;
                        init => {
                            if root.bible-focus {
                                root.bible-focus = false;
                                self.focus-input();
                            }
                        }
                        changed want-focus => {
                            if self.want-focus {
                                root.bible-focus = false;
                                self.focus-input();
                            }
                        }
                        edited => {
                            root.bible-ref-edited();
                        }
                        accepted => {
                            root.bible-go-live();
                        }
                    }
                    // Contoh, atau pesan bila referensi tidak dikenal.
                    if root.bible-translations.length > 0: Text {
                        height: 30px;
                        text: root.bible-error != "" ? root.bible-error : "Contoh: Mzm 23 · Yoh 3:16-18 · 1Kor 13:4-7 · Kej 1:1. Singkatan dan huruf kecil boleh.";
                        color: root.bible-error != "" ? Theme.danger : Theme.text-3;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.bible-translations.length > 0: Rectangle {
                        height: 10px;
                    }
                    if root.bible-translations.length > 0: HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: root.bible-label != "" ? root.bible-label : "Belum ada ayat dipilih";
                                color: root.bible-label != "" ? Theme.text : Theme.text-3;
                                font-size: root.compact-bar ? 22px : 26px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: root.bible-label != "" ? root.bible-detail : "Ketik referensi di kotak atas, atau pilih dari Terakhir dibuka.";
                                color: Theme.text-3;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                        if root.bible-showing && !root.compact-bar: VerticalLayout {
                            alignment: center;
                            PackingSeg {
                                one: root.bible-one-per-slide;
                                picked(one) => {
                                    root.bible-one-per-slide = one;
                                    root.bible-packing-changed();
                                }
                            }
                        }
                        if root.bible-showing: VerticalLayout {
                            alignment: center;
                            Btn {
                                text: root.compact-bar ? "Susunan" : "Ke susunan";
                                icon: Icons.plus;
                                full-text: true;
                                height: 40px;
                                font-size: 13px;
                                pad: 12px;
                                clicked => {
                                    root.bible-add-to-service();
                                }
                            }
                        }
                    }
                    if root.bible-translations.length > 0: Rectangle {
                        height: 16px;
                    }
                    if root.bible-translations.length > 0: HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: root.compact-bar ? 14px : 20px;
                        // Ayat satu pasal.
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.panel;
                            VerticalLayout {
                                padding: 6px;
                                padding-top: 8px;
                                spacing: 4px;
                                if root.bible-chapter-title != "": HorizontalLayout {
                                    height: 34px;
                                    padding-left: 10px;
                                    padding-right: 2px;
                                    spacing: 8px;
                                    Text {
                                        text: root.bible-chapter-title;
                                        color: Theme.text;
                                        font-size: 14px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                    Text {
                                        text: root.compact-bar ? "" : "Shift+klik: pilih rentang";
                                        color: Theme.text-3;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if root.bible-prev-chapter > 0: Btn {
                                        text: "Pasal " + root.bible-prev-chapter;
                                        icon: Icons.left;
                                        full-text: true;
                                        horizontal-stretch: 0;
                                        height: 30px;
                                        font-size: 12px;
                                        pad: 8px;
                                        clicked => {
                                            root.bible-chapter(root.bible-prev-chapter);
                                        }
                                    }
                                    if root.bible-next-chapter > 0: Btn {
                                        text: "Pasal " + root.bible-next-chapter;
                                        icon: Icons.right;
                                        icon-after: true;
                                        full-text: true;
                                        horizontal-stretch: 0;
                                        height: 30px;
                                        font-size: 12px;
                                        pad: 8px;
                                        clicked => {
                                            root.bible-chapter(root.bible-next-chapter);
                                        }
                                    }
                                }
                                if root.bible-verses.length == 0: VerticalLayout {
                                    vertical-stretch: 1;
                                    alignment: center;
                                    padding: 16px;
                                    Text {
                                        text: "Ayat satu pasal tampil di sini. Klik ayat untuk memilih, Shift+klik untuk rentang.";
                                        color: Theme.text-3;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                                if root.bible-verses.length > 0: verse-list := ScrollView {
                                    vertical-stretch: 1;
                                    // Serial gulir yang sudah dijalankan.
                                    property <int> done;
                                    // Lebar berubah, tinggi baris ikut berubah: gulir ulang ke ayat terpilih.
                                    changed visible-width => {
                                        self.done = 0;
                                    }
                                    content-width: self.visible-width;
                                    content-height: verse-col.preferred-height;
                                    verse-col := VerticalLayout {
                                        width: verse-list.visible-width;
                                        padding-right: 8px;
                                        spacing: 2px;
                                        alignment: start;
                                        for row[i] in root.bible-verses: VerseLine {
                                            entry: row;
                                            reveal: i == root.bible-scroll-row && root.bible-scroll-serial != verse-list.done;
                                            clicked(shift) => {
                                                root.bible-verse-clicked(i, shift);
                                            }
                                            activated => {
                                                root.bible-verse-activated(i);
                                            }
                                            revealed => {
                                                verse-list.done = root.bible-scroll-serial;
                                                // Ayat sebelumnya ikut terlihat sebagian.
                                                verse-list.content-y = -Math.min(
                                                    Math.max(self.y - 40px, 0px),
                                                    Math.max(verse-list.content-height - verse-list.visible-height, 0px));
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Hasil slide ayat yang dipilih.
                        VerticalLayout {
                            width: root.compact-bar ? 168px : 232px;
                            spacing: 10px;
                            SectionTitle {
                                text: "Hasil slide";
                                detail: root.bible-showing ? root.slides.length + " slide" : "";
                                padding-left: 0px;
                                padding-right: 0px;
                            }
                            if root.bible-showing && root.compact-bar: PackingSeg {
                                width: 168px;
                                one: root.bible-one-per-slide;
                                picked(one) => {
                                    root.bible-one-per-slide = one;
                                    root.bible-packing-changed();
                                }
                            }
                            if !root.bible-showing: Text {
                                text: "Slide ayat yang dipilih tampil di sini.";
                                color: Theme.text-3;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            if !root.bible-showing: Rectangle {
                                vertical-stretch: 1;
                            }
                            if root.bible-showing: bible-slides := ScrollView {
                                vertical-stretch: 1;
                                property <length> tile-h: self.visible-width * 9 / 16 + 30px;
                                content-width: self.visible-width;
                                content-height: Math.max(0px, root.slides.length * (self.tile-h + 10px) - 10px);
                                for tile[i] in root.slides: SlideTileView {
                                    x: 0px;
                                    y: i * (bible-slides.tile-h + 10px);
                                    width: bible-slides.visible-width;
                                    badge: false;
                                    tile: tile;
                                    number: i + 1;
                                    bg-index: root.bg-index;
                                    picture: root.view-picture;
                                    has-picture: root.has-view-picture;
                                    preview: i == root.preview-page;
                                    live: root.live-item-id == root.selected-id && i == root.live-page && !root.blackout;
                                    clicked => {
                                        keys.focus();
                                        root.select-slide(i);
                                    }
                                    activated => {
                                        root.activate-slide(i);
                                    }
                                }
                            }
                            Text {
                                text: root.bible-one-per-slide ? "Setiap ayat jadi satu slide." : "Ayat dibagi otomatis 1–3 per slide supaya huruf tetap besar di proyektor.";
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Tengah, mode tayang: semua slide materi terpilih.
                if !root.editing && !root.bible-view: VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 20px;
                    padding-bottom: 12px;
                    spacing: 16px;
                    if root.has-current: HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    KindBadge {
                                        song: root.current-song;
                                    }
                                }
                                Text {
                                    text: root.current-meta + (!root.compact-bar && root.selected-service >= 0 ? " · materi ke-" + (root.selected-service + 1) + " di susunan" : "");
                                    color: Theme.text-3;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                                BgChip {
                                    text: root.current-background == "" ? "Latar umum" : "Latar: " + root.current-background;
                                    on: root.current-background != "";
                                    clicked => {
                                        root.show-item-backgrounds();
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            Text {
                                text: root.current-title;
                                color: Theme.text;
                                font-size: 26px;
                                font-weight: 700;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Btn {
                                text: root.compact-bar ? "Edit" : root.current-song ? "Edit lirik" : "Edit ayat";
                                icon: Icons.edit;
                                full-text: true;
                                height: 40px;
                                clicked => {
                                    root.edit-current();
                                }
                            }
                        }
                    }
                    if root.has-current && root.slides.length > 0: grid := ScrollView {
                        vertical-stretch: 1;
                        property <int> cols: Math.max(1, Math.floor((self.visible-width + 16px) / 212px));
                        property <length> tile-w: (self.visible-width - (self.cols - 1) * 16px) / self.cols;
                        property <length> tile-h: self.tile-w * 9 / 16 + 30px;
                        content-width: self.visible-width;
                        content-height: Math.ceil(root.slides.length / self.cols) * (self.tile-h + 14px);
                        for tile[i] in root.slides: SlideTileView {
                            x: Math.mod(i, grid.cols) * (grid.tile-w + 16px);
                            y: Math.floor(i / grid.cols) * (grid.tile-h + 14px);
                            width: grid.tile-w;
                            tile: tile;
                            number: i + 1;
                            bg-index: root.bg-index;
                            picture: root.view-picture;
                            has-picture: root.has-view-picture;
                            preview: i == root.preview-page;
                            live: root.live-item-id == root.selected-id && i == root.live-page && !root.blackout;
                            clicked => {
                                keys.focus();
                                root.select-slide(i);
                            }
                            activated => {
                                root.activate-slide(i);
                            }
                        }
                    }
                    if root.has-current && root.slides.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.current-song ? "Materi ini masih kosong. Tekan Edit lirik untuk mengisi teks." : "Materi ini masih kosong. Tekan Edit ayat untuk mengisi teks.";
                            color: Theme.text-3;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if !root.has-current: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "Pilih materi dari susunan atau pustaka";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Slide-nya akan tampil di sini untuk dipratinjau dan ditayangkan.";
                            color: Theme.text-3;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    // Petunjuk singkat; di jendela sempit tidak muat.
                    if root.has-current && !root.compact-bar: HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Klik";
                            color: Theme.text-2;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            text: "pratinjau dulu";
                            color: Theme.text-3;
                            font-size: 12px;
                        }
                        Rectangle {
                            width: 14px;
                        }
                        Text {
                            text: "Klik dua kali";
                            color: Theme.text-2;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            text: "langsung tayang";
                            color: Theme.text-3;
                            font-size: 12px;
                        }
                        Rectangle {
                            width: 14px;
                        }
                        Text {
                            text: "Tombol 1–9";
                            color: Theme.text-2;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            text: "lompat ke slide";
                            color: Theme.text-3;
                            font-size: 12px;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Tengah, mode edit: formulir di kiri, hasil slide di kanan.
                // Kontrol tayang di kolom kanan tetap terlihat, jadi lirik bisa
                // dibetulkan saat ibadah berjalan.
                if root.editing: VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 20px;
                    padding-bottom: 16px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 12px;
                        Btn {
                            text: "Kembali ke slide";
                            icon: Icons.back;
                            horizontal-stretch: 0;
                            full-text: true;
                            height: 38px;
                            font-size: 13px;
                            pad: 12px;
                            clicked => {
                                root.close-editor();
                                keys.focus();
                            }
                        }
                        if !root.compact-bar: Text {
                            text: "Edit materi pustaka";
                            color: Theme.text-3;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;
                            if !root.editor-dirty: VerticalLayout {
                                alignment: center;
                                Icon {
                                    svg: Icons.check;
                                    color: Theme.ok;
                                    width: 14px;
                                    height: 14px;
                                }
                            }
                            Text {
                                text: root.editor-dirty ? "Menyimpan…" : "Tersimpan";
                                color: root.editor-dirty ? Theme.text-3 : Theme.text-2;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                        Btn {
                            text: "Hapus";
                            icon: Icons.trash;
                            kind: "danger";
                            horizontal-stretch: 0;
                            full-text: true;
                            height: 38px;
                            font-size: 13px;
                            pad: 12px;
                            clicked => {
                                root.delete-current();
                            }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: root.compact-bar ? 14px : 20px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            Text {
                                text: "Judul";
                                color: Theme.text-2;
                                font-size: 13px;
                            }
                            LineEdit {
                                text <=> root.editor-title;
                                font-size: 18px;
                                height: 46px;
                                init => {
                                    if root.focus-title {
                                        self.focus();
                                        self.select-all();
                                    }
                                }
                                edited => {
                                    root.editor-edited();
                                }
                            }
                            Rectangle {
                                height: 6px;
                            }
                            Text {
                                text: "Jenis";
                                color: Theme.text-2;
                                font-size: 13px;
                            }
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 250px;
                                    height: 40px;
                                    border-radius: 10px;
                                    background: Theme.panel;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    HorizontalLayout {
                                        padding: 3px;
                                        spacing: 2px;
                                        SegTab {
                                            text: "Lirik lagu";
                                            icon: Icons.music;
                                            on: root.editor-song;
                                            on-bg: Theme.accent-soft;
                                            on-fg: Theme.accent;
                                            clicked => {
                                                root.set-song(true);
                                            }
                                        }
                                        SegTab {
                                            text: "Ayat Alkitab";
                                            icon: Icons.book;
                                            on: !root.editor-song;
                                            on-bg: Theme.verse-soft;
                                            on-fg: Theme.verse;
                                            clicked => {
                                                root.set-song(false);
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 6px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Isi";
                                    color: Theme.text-2;
                                    font-size: 13px;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: "Satu baris kosong = slide baru";
                                    color: Theme.text-3;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            TextEdit {
                                vertical-stretch: 1;
                                text <=> root.editor-body;
                                font-size: 16px;
                                wrap: word-wrap;
                                edited => {
                                    root.editor-edited();
                                }
                            }
                        }
                        VerticalLayout {
                            width: root.compact-bar ? 168px : 232px;
                            spacing: 10px;
                            SectionTitle {
                                text: "Hasil slide";
                                detail: root.editor-slides.length + " slide";
                                padding-left: 0px;
                                padding-right: 0px;
                            }
                            if root.editor-slides.length == 0: Text {
                                text: "Belum ada slide. Tulis teks di kolom Isi.";
                                color: Theme.text-3;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            results := ScrollView {
                                vertical-stretch: 1;
                                property <length> tile-h: self.visible-width * 9 / 16;
                                // Slide yang belum terlihat utuh di bawah.
                                property <int> below: Math.max(0, root.editor-slides.length - Math.floor((self.visible-height - self.content-y + 12px) / (self.tile-h + 12px)));
                                content-width: self.visible-width;
                                content-height: Math.max(0px, root.editor-slides.length * (self.tile-h + 12px) - 12px);
                                for tile[i] in root.editor-slides: Rectangle {
                                    y: i * (results.tile-h + 12px);
                                    width: results.visible-width;
                                    height: results.tile-h;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #2A303C;
                                    clip: true;
                                    background: Theme.slide-bg[root.bg-index];
                                    if root.has-view-picture: PictureFill {
                                        width: parent.width;
                                        height: parent.height;
                                        picture: root.view-picture;
                                    }
                                    SlideText {
                                        width: parent.width;
                                        height: parent.height;
                                        text: tile.text;
                                        lines: tile.lines;
                                        chars: tile.chars;
                                        verse: tile.verse;
                                        ink: root.has-view-picture ? Theme.picture-ink : Theme.slide-ink[root.bg-index];
                                        outline: root.has-view-picture;
                                    }
                                    Rectangle {
                                        x: 8px;
                                        y: 8px;
                                        width: number.preferred-width + 12px;
                                        height: 20px;
                                        border-radius: 5px;
                                        background: #0B0D12B3;
                                        number := Text {
                                            text: i + 1;
                                            color: #E6E9EF;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            // Tinggi tetap: petunjuk ini tidak boleh mengubah tinggi daftar.
                            Rectangle {
                                height: 16px;
                                // x dan y tetap: ukuran teks tidak ikut menentukan ukuran kotak.
                                Text {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: results.below > 0 ? "Gulir untuk " + results.below + " slide lagi" : "";
                                    color: Theme.text-3;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            Btn {
                                text: "Tambah ke susunan";
                                icon: Icons.plus;
                                height: 44px;
                                font-size: 13px;
                                pad: 10px;
                                clicked => {
                                    root.add-current-to-service();
                                }
                            }
                        }
                    }
                }

                // Kolom kanan: yang dilihat jemaat, pratinjau, dan kontrol, juga
                // saat mengedit. Tombol gelapkan dan layar penuh selalu di bawah.
                Rectangle {
                    width: root.compact-bar ? 300px : root.side-width;
                    background: Theme.panel;
                    side := ScrollView {
                        content-width: self.visible-width;
                        content-height: controls.height;
                        controls := VerticalLayout {
                            width: side.visible-width;
                            height: Math.max(self.preferred-height, side.visible-height);
                            padding: root.compact-bar ? 16px : 20px;
                            padding-top: 18px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Theme.live;
                                    }
                                }
                                Text {
                                    text: "Layar jemaat";
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: !root.has-live ? "Belum ada yang tayang"
                                        : root.blackout ? "Layar digelapkan"
                                        : "Slide " + (root.live-page + 1) + " dari " + root.live-total;
                                    color: Theme.text-3;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            Screen {
                                height: self.width * 9 / 16;
                                tile: root.live;
                                show-caption: true;
                                has-slide: root.has-live;
                                dark: root.blackout;
                                bg-index: root.bg-index;
                                picture: root.live-picture;
                                has-picture: root.has-live-picture;
                                ring: root.has-live && !root.blackout ? Theme.live : Theme.border;
                                empty-text: "Belum ada yang tayang";
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.live-title;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: root.live-caption;
                                    color: Theme.text-3;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn {
                                    text: "Sebelumnya";
                                    icon: Icons.left;
                                    kbd: root.compact-bar ? "" : "PgUp";
                                    height: 48px;
                                    font-size: 13px;
                                    pad: 10px;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        keys.focus();
                                        root.navigate(false);
                                    }
                                }
                                Btn {
                                    text: "Berikutnya";
                                    icon: Icons.right;
                                    icon-after: true;
                                    kind: "strong";
                                    kbd: root.compact-bar ? "" : "PgDn";
                                    height: 48px;
                                    font-size: 13px;
                                    pad: 10px;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        keys.focus();
                                        root.navigate(true);
                                    }
                                }
                            }
                            Rectangle {
                                height: 4px;
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Screen {
                                    width: root.compact-bar ? 120px : 150px;
                                    height: self.width * 9 / 16;
                                    radius: 8px;
                                    inset: 3px;
                                    tile: root.preview;
                                    has-slide: root.has-preview;
                                    bg-index: root.bg-index;
                                    picture: root.view-picture;
                                    has-picture: root.has-view-picture;
                                    ring: root.has-preview ? Theme.accent : Theme.border;
                                    empty-text: "";
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Pratinjau";
                                        color: Theme.accent;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.has-preview ? root.preview-title : "Belum ada slide dipilih";
                                        color: root.has-preview ? Theme.text : Theme.text-3;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                    if !root.compact-bar: Text {
                                        text: !root.has-preview ? "Klik slide untuk dipratinjau."
                                            : root.live-item-id == root.selected-id && root.preview-page == root.live-page && !root.blackout ? "Sudah tayang."
                                            : "Belum terlihat jemaat. Tekan Tayangkan untuk menampilkan.";
                                        color: Theme.text-3;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            Btn {
                                kind: "primary";
                                text: "Tayangkan";
                                icon: Icons.play;
                                icon-filled: true;
                                kbd: "F5";
                                height: 52px;
                                font-size: 16px;
                                clicked => {
                                    keys.focus();
                                    root.go-live();
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                min-height: 4px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn {
                                    text: root.blackout ? "Pulihkan" : "Gelapkan";
                                    icon: root.blackout ? Icons.sun : Icons.moon;
                                    kbd: root.compact-bar ? "" : "F6";
                                    on: root.blackout;
                                    font-size: 13px;
                                    pad: 10px;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        keys.focus();
                                        root.toggle-blackout();
                                    }
                                }
                                Btn {
                                    text: root.fullscreen ? "Jendela" : "Layar penuh";
                                    icon: root.fullscreen ? Icons.minimize : Icons.maximize;
                                    kbd: root.compact-bar ? "" : "F11";
                                    font-size: 13px;
                                    pad: 10px;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        keys.focus();
                                        root.toggle-fullscreen();
                                    }
                                }
                            }
                            if !root.compact-bar: Text {
                                text: "Latar umum";
                                color: Theme.text-2;
                                font-size: 12px;
                            }
                            if !root.compact-bar: HorizontalLayout {
                                spacing: 10px;
                                for name[i] in Theme.slide-names: Swatch {
                                    index: i;
                                    on: i == root.bg-index && !root.has-bg-picture;
                                    clicked => {
                                        root.background-changed(i);
                                    }
                                }
                                PictureSwatch {
                                    picture: root.bg-picture;
                                    on: root.has-bg-picture;
                                    clicked => {
                                        root.show-backgrounds();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: 0;
                        width: 1px;
                        background: Theme.line;
                    }
                }
            }

            // Bilah bawah: status, tombol cepat, dan pembaruan.
            Rectangle {
                height: 34px;
                background: Theme.bar;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 12px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 7px;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                svg: root.status-ok ? Icons.check : Icons.info;
                                color: root.status-ok ? Theme.ok : Theme.accent;
                                width: 14px;
                                height: 14px;
                            }
                        }
                        Text {
                            text: root.status;
                            color: root.status-ok ? Theme.text-3 : Theme.text-2;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Kbd {
                                text: "F5";
                            }
                        }
                        Text {
                            text: "tayangkan";
                            color: Theme.text-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            Kbd {
                                text: "PgDn";
                            }
                        }
                        Text {
                            text: "berikutnya";
                            color: Theme.text-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            Kbd {
                                text: "F6";
                            }
                        }
                        Text {
                            text: "gelapkan";
                            color: Theme.text-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if !root.compact-bar: VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            Kbd {
                                text: "Ctrl K";
                            }
                        }
                        if !root.compact-bar: Text {
                            text: "cari";
                            color: Theme.text-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    if root.update-version != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            width: update-label.preferred-width + 44px;
                            border-radius: 14px;
                            background: update-touch.has-hover ? #3A3018 : Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.accent;
                            accessible-role: button;
                            accessible-label: update-label.text;
                            accessible-action-default => {
                                root.update-now();
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        svg: Icons.refresh;
                                        color: #F7D58A;
                                        width: 14px;
                                        height: 14px;
                                    }
                                }
                                update-label := Text {
                                    text: "Perbarui ke " + root.update-version;
                                    color: #F7D58A;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            update-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.update-now();
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.picking-profile: ProfileScreen {
            width: parent.width;
            height: parent.height;
            profiles: root.profiles;
            current-name: root.profile-name;
            form <=> root.profile-form;
            form-name <=> root.profile-form-name;
            form-target <=> root.profile-form-target;
            form-error <=> root.profile-form-error;
            choose(id) => {
                root.choose-profile(id);
            }
            close => {
                root.close-profiles();
            }
            submit => {
                root.submit-profile-form();
            }
            remove(id) => {
                root.delete-profile(id);
            }
        }
    }
}

// Jendela yang dilihat jemaat (proyektor / layar kedua).
// Layar masuk: muncul sebelum jendela operator bila Lentera belum masuk ke
// akun, dan saat sesi perlu diperbarui.
export component LoginWindow inherits Window {
    in property <string> version;
    // 0: email, 1: kode, 2: menyiapkan profil.
    in-out property <int> step;
    in-out property <string> email;
    in-out property <string> code;
    in property <string> error;
    in property <bool> busy;
    // Server tidak terjangkau dan komputer ini sudah punya data: boleh dibuka
    // tanpa masuk dulu.
    in property <bool> can-skip;
    // Detik sampai kode boleh dikirim ulang.
    in property <int> resend-wait;
    // Masuk lagi saat Lentera sudah terbuka: ada tombol Batal.
    in property <bool> again;
    callback send-code();
    callback verify();
    callback change-email();
    callback skip();
    callback cancel();
    title: "Masuk ke Lentera";
    preferred-width: 520px;
    preferred-height: 660px;
    min-width: 420px;
    min-height: 600px;
    background: Theme.bg;

    VerticalLayout {
        padding: 32px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                preferred-width: 380px;
                max-width: 380px;
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../assets/icon/lentera.svg");
                        width: 64px;
                        height: 64px;
                    }
                }
                Text {
                    text: root.step == 2 ? "Menyiapkan profil" : "Masuk ke Lentera";
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.step == 0
                        ? "Masukkan email Anda. Lentera mengirim kode 6 digit, tanpa kata sandi. Profil, lirik, ayat, dan susunan ibadah tersimpan di akun ini dan ikut ke komputer lain."
                        : root.step == 1 ? "Kode masuk dikirim ke " + root.email + ". Kode berlaku 10 menit; periksa juga folder spam."
                        : "Mengambil profil dari akun Anda. Ini hanya sekali dan biasanya sebentar.";
                    color: Theme.text-2;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.step == 0: VerticalLayout {
                    spacing: 8px;
                    padding-top: 6px;
                    Text {
                        text: "Email";
                        color: Theme.text-2;
                        font-size: 13px;
                    }
                    LineEdit {
                        placeholder-text: "nama@gereja.org";
                        text <=> root.email;
                        init => {
                            self.focus();
                        }
                        accepted => {
                            root.send-code();
                        }
                    }
                }
                if root.step == 0: Btn {
                    text: root.busy ? "Mengirim kode…" : "Kirim kode masuk";
                    kind: "primary";
                    icon: Icons.right;
                    icon-after: true;
                    clicked => {
                        root.send-code();
                    }
                }
                if root.step == 1: VerticalLayout {
                    spacing: 8px;
                    padding-top: 6px;
                    Text {
                        text: "Kode masuk";
                        color: Theme.text-2;
                        font-size: 13px;
                    }
                    LineEdit {
                        placeholder-text: "6 digit dari email";
                        text <=> root.code;
                        init => {
                            self.focus();
                        }
                        accepted => {
                            root.verify();
                        }
                    }
                }
                if root.step == 1: Btn {
                    text: root.busy ? "Memeriksa kode…" : "Masuk";
                    kind: "primary";
                    icon: Icons.check;
                    clicked => {
                        root.verify();
                    }
                }
                if root.step == 1: HorizontalLayout {
                    alignment: space-between;
                    Btn {
                        text: "Ganti email";
                        kind: "ghost";
                        icon: Icons.back;
                        clicked => {
                            root.change-email();
                        }
                    }
                    Btn {
                        text: root.resend-wait > 0 ? "Kirim ulang (" + root.resend-wait + ")" : "Kirim ulang";
                        kind: "ghost";
                        clicked => {
                            root.send-code();
                        }
                    }
                }
                if root.error != "": Text {
                    text: root.error;
                    color: Theme.danger;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.can-skip: VerticalLayout {
                    spacing: 6px;
                    padding-top: 6px;
                    Btn {
                        text: "Buka tanpa masuk untuk sementara";
                        clicked => {
                            root.skip();
                        }
                    }
                    Text {
                        text: "Data di komputer ini tetap bisa dipakai. Sinkron baru berjalan setelah Anda masuk.";
                        color: Theme.text-3;
                        font-size: 12px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                if root.again: Btn {
                    text: "Batal";
                    kind: "ghost";
                    clicked => {
                        root.cancel();
                    }
                }
            }
        }
        Text {
            text: "Lentera " + root.version;
            color: Theme.num;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}

export component OutputWindow inherits Window {
    in property <SlideTile> tile;
    in property <bool> has-slide;
    in property <bool> dark;
    in property <int> bg-index;
    in property <image> picture;
    in property <bool> has-picture;
    in property <bool> fullscreen;
    callback go-live();
    callback navigate(bool);
    callback toggle-blackout();
    callback toggle-fullscreen();
    callback escape();

    title: "Lentera · Proyektor";
    preferred-width: 960px;
    preferred-height: 540px;
    background: root.dark ? #000000 : Theme.slide-bg[root.bg-index];

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.F5 {
                root.go-live();
                return accept;
            }
            if event.text == Key.F6 {
                root.toggle-blackout();
                return accept;
            }
            if event.text == Key.F11 {
                root.toggle-fullscreen();
                return accept;
            }
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            if event.text == Key.PageDown || event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == " " {
                root.navigate(true);
                return accept;
            }
            if event.text == Key.PageUp || event.text == Key.LeftArrow || event.text == Key.UpArrow {
                root.navigate(false);
                return accept;
            }
            reject
        }
        if root.has-picture && !root.dark: PictureFill {
            width: parent.width;
            height: parent.height;
            picture: root.picture;
        }
        if root.has-slide && !root.dark: SlideText {
            width: parent.width;
            height: parent.height;
            text: root.tile.text;
            lines: root.tile.lines;
            chars: root.tile.chars;
            verse: root.tile.verse;
            caption: root.tile.caption;
            ink: root.has-picture ? Theme.picture-ink : Theme.slide-ink[root.bg-index];
            caption-ink: root.has-picture ? Theme.picture-caption : Theme.slide-caption[root.bg-index];
            outline: root.has-picture;
        }
        TouchArea {
            mouse-cursor: root.fullscreen ? MouseCursor.none : MouseCursor.default;
            double-clicked => {
                root.toggle-fullscreen();
            }
        }
    }
}
