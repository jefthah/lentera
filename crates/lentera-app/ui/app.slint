component Icon inherits Path {
    in property <string> svg;
    in property <color> color: Theme.text;
    in property <bool> filled;
    commands: root.svg;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    stroke: root.filled ? transparent : root.color;
    fill: root.filled ? root.color : transparent;
    stroke-width: 1.8px;
    stroke-line-cap: round;
}

component Kbd inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-2;
    in property <color> outline: #343B4A;
    height: 20px;
    width: label.preferred-width + 12px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.outline;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> icon-filled;
    // Ikon di kanan teks, misalnya panah Berikutnya.
    in property <bool> icon-after;
    // "primary", "secondary", "strong" (secondary yang lebih menonjol),
    // "ghost", atau "danger".
    in property <string> kind: "secondary";
    in property <string> kbd;
    in property <bool> on;
    in property <length> font-size: 14px;
    in property <length> pad: 14px;
    // Teks tidak boleh dipotong; ruang diambil dari elemen lain di baris.
    in property <bool> full-text;
    callback clicked();
    property <color> fg: root.kind == "primary" ? Theme.on-accent : root.kind == "danger" ? Theme.danger : Theme.text;
    height: 44px;
    border-radius: 12px;
    background: root.kind == "primary"
        ? (touch.pressed ? Theme.accent.darker(0.15) : touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : root.on ? Theme.accent-soft
        : root.kind == "ghost" || root.kind == "danger" ? (touch.has-hover ? Theme.hover : transparent)
        : root.kind == "strong" ? (touch.pressed ? #2A3140 : touch.has-hover ? #262C3A : Theme.active)
        : (touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : Theme.raised);
    border-width: root.kind == "primary" || root.kind == "ghost" ? 0px : 1px;
    border-color: root.on ? Theme.accent : root.kind == "danger" ? #4A2A2E : root.kind == "strong" ? Theme.active-border : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        alignment: center;
        spacing: root.pad < 14px ? 6px : 8px;
        padding-left: root.pad;
        padding-right: root.pad;
        if root.icon != "" && !root.icon-after: VerticalLayout {
            alignment: center;
            Icon {
                svg: root.icon;
                color: root.fg;
                filled: root.icon-filled;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            min-width: root.full-text ? self.preferred-width : 0px;
        }
        if root.icon != "" && root.icon-after: VerticalLayout {
            alignment: center;
            Icon {
                svg: root.icon;
                color: root.fg;
                filled: root.icon-filled;
            }
        }
        if root.kbd != "": VerticalLayout {
            alignment: center;
            Kbd {
                text: root.kbd;
                ink: root.kind == "primary" ? Theme.on-accent : Theme.text-2;
                outline: root.kind == "primary" ? #1A120455 : #343B4A;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <length> size: 36px;
    in property <color> tint: Theme.text-2;
    in property <bool> bordered: true;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: 10px;
    background: touch.pressed ? Theme.active : touch.has-hover ? #262B36 : (root.bordered ? Theme.raised : transparent);
    border-width: root.bordered ? 1px : 0px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        svg: root.icon;
        color: touch.has-hover ? Theme.text : root.tint;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <length> pad: 13px;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 2 * root.pad;
    border-radius: 16px;
    background: root.on ? #232835 : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.on ? #3A4150 : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.on ? Theme.text : Theme.text-2;
        font-size: 13px;
        font-weight: root.on ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Kotak cari di bilah atas. Ctrl+K memindahkan fokus ke sini.
component SearchBox inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited();
    callback accepted();
    public function focus-input() {
        input.focus();
        input.select-all();
    }
    height: 40px;
    border-radius: 10px;
    background: Theme.raised;
    border-width: 1px;
    border-color: input.has-focus ? #4A5263 : Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                svg: Icons.search;
                color: Theme.text-3;
                width: 17px;
                height: 17px;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            if root.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.text-3;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                color: Theme.text;
                font-size: 14px;
                single-line: true;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: "Cari di pustaka";
                edited => {
                    root.edited();
                }
                accepted => {
                    root.accepted();
                }
            }
        }
        if root.text == "": VerticalLayout {
            alignment: center;
            Kbd {
                text: "Ctrl K";
            }
        }
        if root.text != "": VerticalLayout {
            alignment: center;
            IconBtn {
                icon: Icons.close;
                label: "Kosongkan pencarian";
                size: 28px;
                bordered: false;
                clicked => {
                    root.text = "";
                    root.edited();
                }
            }
        }
    }
}

// Status proyektor di bilah atas; hijau berarti proyektor menyala. Saat mati,
// klik membuka proyektor. Panah, atau klik saat menyala, membuka menu monitor,
// latar, dan tutup proyektor, supaya proyektor tidak tertutup tanpa sengaja.
component ProjectorButton inherits Rectangle {
    in property <bool> on;
    in property <string> monitor;
    in property <bool> compact;
    callback toggle();
    callback menu();
    height: 40px;
    width: row.preferred-width;
    border-radius: 10px;
    background: root.on
        ? (main.has-hover || arrow.has-hover ? #15301F : Theme.ok-soft)
        : (main.pressed ? Theme.active : main.has-hover ? Theme.hover : Theme.raised);
    border-width: 1px;
    border-color: root.on ? Theme.ok-border : Theme.border;
    accessible-role: button;
    accessible-label: root.on ? "Proyektor menyala di " + root.monitor + ". Buka menu proyektor" : "Buka proyektor";
    accessible-action-default => {
        if root.on {
            root.menu();
        } else {
            root.toggle();
        }
    }
    row := HorizontalLayout {
        padding-left: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            if root.on: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.ok;
            }
            if !root.on: Icon {
                svg: Icons.monitor;
                color: Theme.text;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: root.on ? "Proyektor menyala" : "Buka proyektor";
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if !root.compact && root.monitor != "": Text {
            text: root.monitor;
            color: root.on ? #8FBFA3 : Theme.text-3;
            font-size: 13px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 34px;
            Rectangle {
                x: 0;
                y: 9px;
                width: 1px;
                height: parent.height - 18px;
                background: root.on ? transparent : Theme.border;
            }
            Icon {
                svg: Icons.chevron;
                color: root.on ? #8FBFA3 : Theme.text-2;
                width: 15px;
                height: 15px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
    main := TouchArea {
        x: 0;
        width: parent.width - 34px;
        mouse-cursor: pointer;
        clicked => {
            if root.on {
                root.menu();
            } else {
                root.toggle();
            }
        }
    }
    arrow := TouchArea {
        x: parent.width - 34px;
        width: 34px;
        mouse-cursor: pointer;
        clicked => {
            root.menu();
        }
    }
}

// Baris pilihan dengan tanda centang, misalnya monitor proyektor.
component CheckRow inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.text;
            color: root.on ? Theme.text : Theme.text-2;
            font-size: 13px;
            font-weight: root.on ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.on: VerticalLayout {
            alignment: center;
            Icon {
                svg: Icons.check;
                color: Theme.ok;
                width: 16px;
                height: 16px;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Label jenis materi di atas judul: Lirik (amber) atau Ayat (biru).
component KindBadge inherits Rectangle {
    in property <bool> song;
    height: 22px;
    width: label.preferred-width + 14px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.song ? Theme.accent-soft : Theme.verse-soft;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.song ? "Lirik" : "Ayat";
        color: root.song ? Theme.accent : Theme.verse;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Satu tab bersegmen di kolom kiri.
component SegTab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> count;
    in property <bool> on;
    // Warna tab terpilih: abu-abu, atau amber / biru untuk jenis materi.
    in property <color> on-bg: Theme.active;
    in property <color> on-fg: Theme.text;
    callback clicked();
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.on ? root.on-bg : touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                svg: root.icon;
                color: root.on ? root.on-fg : Theme.text-3;
                width: 15px;
                height: 15px;
            }
        }
        Text {
            text: root.text;
            color: root.on ? root.on-fg : Theme.text-2;
            font-size: 13px;
            font-weight: root.on ? 600 : 500;
            vertical-alignment: center;
        }
        if root.count != "": Text {
            text: root.count;
            color: Theme.text-3;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Latar materi terpilih, di samping keterangan di atas judul. Klik untuk
// memilih gambar latar khusus materi itu.
component BgChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 26px;
    max-width: 300px;
    horizontal-stretch: 0;
    border-radius: 13px;
    background: root.on ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 11px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                svg: Icons.image;
                color: root.on ? Theme.text : Theme.text-2;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.text;
            color: root.on ? Theme.text : Theme.text-2;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Teks slide yang ukurannya menyesuaikan kotak, seperti di layar proyektor.
component SlideText inherits Rectangle {
    in property <string> text;
    in property <int> lines: 1;
    in property <int> chars: 10;
    in property <color> ink;
    // Referensi ayat di bawah teks; kosong bila tidak ada.
    in property <string> caption;
    in property <color> caption-ink: root.ink;
    // Ayat memakai huruf sedikit lebih tipis dari lirik.
    in property <bool> verse;
    // Garis tepi gelap, untuk teks di atas gambar latar.
    in property <bool> outline;
    // Ukuran dari desain layar 960×540: keterangan 22 px, 28 px di bawah ayat.
    // Diukur dari bidang 16:9 yang muat di layar, supaya di monitor tegak
    // keterangan tidak lebih besar dari ayatnya.
    property <length> unit: Math.min(root.height, root.width * 9 / 16);
    property <length> caption-size: root.unit * 0.041;
    property <length> caption-gap: root.unit * 0.052;
    property <length> caption-room: root.caption == "" ? 0px : root.caption-size * 1.3 + root.caption-gap;
    // Tinggi yang tersedia untuk teks, dan ukuran huruf yang muat.
    property <length> area: root.height * 0.84 - root.caption-room;
    property <length> fit: Math.min(
        root.area / (Math.max(root.lines, 1) * 1.32),
        root.width * 0.88 / (Math.max(root.chars, 10) * 0.55),
        root.height / 6.5);
    // Dengan keterangan, teks dan keterangan bersama-sama di tengah layar.
    property <length> block: root.caption == "" ? root.area : Math.min(Math.max(root.lines, 1) * root.fit * 1.32, root.area);
    property <length> block-y: (root.height - root.block - root.caption-room) / 2;
    Text {
        x: parent.width * 0.06;
        y: root.block-y;
        width: parent.width * 0.88;
        height: root.block;
        text: root.text;
        color: root.ink;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: root.verse ? 600 : 700;
        font-size: root.fit;
        stroke: root.outline ? Theme.picture-outline : transparent;
        stroke-width: root.outline ? Math.max(self.font-size * 0.07, 1px) : 0px;
        stroke-style: outside;
    }
    if root.caption != "": Text {
        x: parent.width * 0.06;
        y: root.block-y + root.block + root.caption-gap;
        width: parent.width * 0.88;
        height: root.caption-size * 1.3;
        text: root.caption;
        color: root.caption-ink;
        font-size: root.caption-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        stroke: root.outline ? Theme.picture-outline : transparent;
        stroke-width: root.outline ? Math.max(self.font-size * 0.07, 1px) : 0px;
        stroke-style: outside;
    }
}

// Gambar latar yang menutup seluruh slide, sedikit digelapkan.
component PictureFill inherits Rectangle {
    in property <image> picture;
    background: #000000;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.picture;
        image-fit: cover;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.picture-dim;
    }
}

component SlideTileView inherits Rectangle {
    in property <SlideTile> tile;
    in property <int> number;
    in property <bool> preview;
    in property <bool> live;
    in property <int> bg-index;
    in property <image> picture;
    in property <bool> has-picture;
    // Label Pratinjau / Tayang di pojok; di kartu sempit cukup bingkainya.
    in property <bool> badge: true;
    callback clicked();
    callback activated();
    property <length> thumb-h: self.width * 9 / 16;
    height: self.thumb-h + 30px;
    accessible-role: button;
    accessible-label: "Slide " + root.number + ": " + root.tile.first;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.thumb-h;
        border-radius: 14px;
        border-width: root.live || root.preview ? 2px : 1px;
        border-color: root.live ? Theme.live : root.preview ? Theme.accent : touch.has-hover ? #3A4150 : #2A303C;
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-radius: 10px;
            clip: true;
            background: Theme.slide-bg[root.bg-index];
            if root.has-picture: PictureFill {
                width: parent.width;
                height: parent.height;
                picture: root.picture;
            }
            SlideText {
                width: parent.width;
                height: parent.height;
                text: root.tile.text;
                lines: root.tile.lines;
                chars: root.tile.chars;
                verse: root.tile.verse;
                ink: root.has-picture ? Theme.picture-ink : Theme.slide-ink[root.bg-index];
                outline: root.has-picture;
            }
            if root.badge && (root.live || root.preview): Rectangle {
                x: 8px;
                y: 8px;
                height: 22px;
                width: badge.preferred-width + 16px;
                border-radius: 6px;
                background: root.live ? Theme.live-badge : Theme.accent;
                badge := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.live ? "Tayang" : "Pratinjau";
                    color: root.live ? #FFFFFF : Theme.on-accent;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    HorizontalLayout {
        y: root.thumb-h + 8px;
        height: 20px;
        width: parent.width;
        spacing: 8px;
        padding-left: 2px;
        Text {
            text: root.number;
            color: root.live ? Theme.live : root.preview ? Theme.accent : #C5CBD6;
            font-size: 13px;
            font-weight: 600;
        }
        Text {
            text: root.tile.first;
            color: root.live || root.preview ? Theme.text-2 : Theme.text-3;
            font-size: 13px;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.activated();
        }
    }
}

// Layar kecil di kolom kanan: pratinjau atau yang sedang tayang.
component Screen inherits Rectangle {
    in property <SlideTile> tile;
    in property <bool> has-slide;
    in property <bool> dark;
    in property <int> bg-index;
    in property <image> picture;
    in property <bool> has-picture;
    in property <color> ring;
    in property <string> empty-text;
    // Tampilkan referensi ayat seperti di proyektor (layar jemaat).
    in property <bool> show-caption;
    in property <length> radius: 14px;
    in property <length> inset: 4px;
    border-radius: root.radius;
    border-width: 2px;
    border-color: root.ring;
    Rectangle {
        x: root.inset;
        y: root.inset;
        width: parent.width - 2 * root.inset;
        height: parent.height - 2 * root.inset;
        border-radius: Math.max(0px, root.radius - root.inset);
        clip: true;
        background: root.dark ? #000000 : Theme.slide-bg[root.bg-index];
        if root.has-picture && !root.dark: PictureFill {
            width: parent.width;
            height: parent.height;
            picture: root.picture;
        }
        if root.has-slide && !root.dark: SlideText {
            width: parent.width;
            height: parent.height;
            text: root.tile.text;
            lines: root.tile.lines;
            chars: root.tile.chars;
            verse: root.tile.verse;
            caption: root.show-caption ? root.tile.caption : "";
            ink: root.has-picture ? Theme.picture-ink : Theme.slide-ink[root.bg-index];
            caption-ink: root.has-picture ? Theme.picture-caption : Theme.slide-caption[root.bg-index];
            outline: root.has-picture;
        }
        if root.dark || !root.has-slide: Text {
            width: parent.width;
            height: parent.height;
            text: root.dark ? "Layar jemaat gelap" : root.empty-text;
            color: root.has-picture && !root.dark ? #FFFFFFCC : root.bg-index == 2 && !root.dark ? #6B6A63 : Theme.text-3;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ServiceRowView inherits Rectangle {
    in property <ServiceRow> entry;
    in property <int> index;
    in property <bool> selected;
    in property <bool> on-air;
    // Sudah lewat: sebelum materi yang sedang tayang.
    in property <bool> done;
    // Keterangan pengganti saat tayang, misalnya "Lirik · slide 3 dari 8".
    in property <string> live-detail;
    // Kolom sempit: tombol urutan hanya muncul saat baris disorot.
    in property <bool> compact;
    callback clicked();
    callback activated();
    callback up();
    callback down();
    callback remove();
    height: 54px;
    border-radius: 10px;
    background: root.selected ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.selected ? Theme.active-border : transparent;
    accessible-role: list-item;
    accessible-label: (root.index + 1) + ". " + root.entry.title + (root.on-air ? ", sedang tayang" : root.done ? ", sudah lewat" : "");
    accessible-action-default => {
        root.clicked();
    }
    // Tombol urutan muncul saat baris disorot, dan di jendela lebar juga di
    // baris terpilih yang tidak sedang tayang. Isinya di dalam TouchArea supaya
    // sorotan tetap ada saat kursor di atas tombol.
    property <bool> show-controls: touch.has-hover || (root.selected && !root.on-air && !root.compact);
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.activated();
        }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 10px;
            Text {
                width: 20px;
                text: (root.index + 1 < 10 ? "0" : "") + (root.index + 1);
                color: Theme.num;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: root.entry.song ? Theme.accent-soft : Theme.verse-soft;
                    Icon {
                        svg: root.entry.song ? Icons.music : Icons.book;
                        color: root.entry.song ? Theme.accent : Theme.verse;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.entry.title;
                    color: root.done && !root.selected ? Theme.text-2 : Theme.text;
                    font-size: 14px;
                    font-weight: 500;
                    overflow: elide;
                }
                Text {
                    text: root.on-air ? root.live-detail : root.entry.meta;
                    color: root.on-air ? #FF8A8E : Theme.text-3;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            if root.done && !root.on-air && !root.show-controls: VerticalLayout {
                alignment: center;
                padding-right: 8px;
                Icon {
                    svg: Icons.check;
                    color: Theme.text-3;
                    width: 16px;
                    height: 16px;
                }
            }
            if root.on-air && !root.show-controls && !root.compact: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 22px;
                    width: 70px;
                    border-radius: 11px;
                    background: Theme.live-badge;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #FFFFFF;
                            }
                        }
                        Text {
                            text: "Tayang";
                            color: #FFFFFF;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if root.show-controls: HorizontalLayout {
                spacing: 0px;
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        icon: Icons.up;
                        label: "Naikkan";
                        size: 30px;
                        bordered: false;
                        clicked => {
                            root.up();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        icon: Icons.down;
                        label: "Turunkan";
                        size: 30px;
                        bordered: false;
                        clicked => {
                            root.down();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        icon: Icons.close;
                        label: "Lepas dari susunan";
                        size: 30px;
                        bordered: false;
                        clicked => {
                            root.remove();
                        }
                    }
                }
            }
        }
    }
}

component LibraryRowView inherits Rectangle {
    in property <LibraryRow> entry;
    in property <bool> selected;
    // Kolom sempit: tanda dan tombol tanpa teks.
    in property <bool> compact;
    callback clicked();
    callback activated();
    callback add();
    // Tombol "+ Susunan" tampil saat baris disorot atau terpilih. Di luar itu
    // materi yang sudah ada di susunan bertanda "Di susunan".
    property <bool> show-add: root.selected || touch.has-hover || add-touch.has-hover;
    height: 48px;
    border-radius: 10px;
    background: root.selected ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-action-default => {
        root.clicked();
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.activated();
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.entry.song ? Theme.accent : Theme.verse;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.entry.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: root.selected ? 600 : 400;
                overflow: elide;
            }
            Text {
                text: root.entry.meta;
                color: Theme.text-3;
                font-size: 12px;
                overflow: elide;
            }
        }
        Rectangle {
            width: root.compact ? 32px : 92px;
            if root.entry.in-service && !root.show-add: HorizontalLayout {
                alignment: end;
                spacing: 4px;
                padding-right: 6px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        svg: Icons.check;
                        color: Theme.text-3;
                        width: 13px;
                        height: 13px;
                    }
                }
                if !root.compact: Text {
                    text: "Di susunan";
                    color: Theme.text-3;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                visible: root.show-add;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                height: 30px;
                width: add-row.preferred-width;
                border-radius: 8px;
                background: add-touch.pressed ? Theme.active : add-touch.has-hover ? #262B36 : Theme.raised;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: button;
                accessible-label: "Tambah " + root.entry.title + " ke susunan";
                accessible-action-default => {
                    root.add();
                }
                add-row := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: root.compact ? 8px : 10px;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            svg: Icons.plus;
                            color: Theme.text;
                            width: 14px;
                            height: 14px;
                        }
                    }
                    if !root.compact: Text {
                        text: "Susunan";
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                add-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.add();
                    }
                }
            }
        }
    }
}

// Satu ayat di daftar pasal (kolom tengah), teksnya utuh. Shift+klik
// memilih rentang.
component VerseLine inherits Rectangle {
    in property <VerseRow> entry;
    // Daftar perlu digulir ke ayat ini. Ditunda sebentar supaya letak ayat
    // sudah dihitung.
    in property <bool> reveal;
    // Argumen: Shift ditekan.
    callback clicked(bool);
    callback activated();
    callback revealed();
    property <bool> shift;
    border-radius: 10px;
    background: root.entry.picked ? Theme.verse-soft : touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.entry.number + " " + root.entry.text;
    accessible-checked: root.entry.picked;
    accessible-action-default => {
        root.clicked(false);
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        Text {
            width: 34px;
            text: root.entry.number;
            color: root.entry.picked ? Theme.verse : Theme.num;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: top;
        }
        Text {
            horizontal-stretch: 1;
            text: root.entry.text;
            color: root.entry.picked ? Theme.text : Theme.text-2;
            font-size: 14px;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.shift = event.modifiers.shift;
            }
        }
        clicked => {
            root.clicked(root.shift);
        }
        double-clicked => {
            root.activated();
        }
    }
    Timer {
        interval: 30ms;
        running: root.reveal;
        triggered => {
            root.revealed();
        }
    }
}

// Kotak referensi Alkitab di kolom tengah. Enter menayangkan.
component RefBox inherits Rectangle {
    in-out property <string> text;
    in property <bool> compact;
    callback edited();
    callback accepted();
    public function focus-input() {
        input.focus();
        input.select-all();
    }
    height: 54px;
    border-radius: 12px;
    background: Theme.raised;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.verse : Theme.border;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                svg: Icons.book;
                color: Theme.verse;
                width: 20px;
                height: 20px;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            if root.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: "Ketik referensi, misalnya Yoh 3:16-18";
                color: Theme.text-3;
                font-size: 18px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                color: Theme.text;
                font-size: 19px;
                single-line: true;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: "Referensi Alkitab";
                edited => {
                    root.edited();
                }
                accepted => {
                    root.accepted();
                }
            }
        }
        if !root.compact: HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;
            VerticalLayout {
                alignment: center;
                Kbd {
                    text: "Enter";
                }
            }
            Text {
                text: "langsung tayang";
                color: Theme.text-3;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

// Pilihan pembagian ayat ke slide.
component PackingSeg inherits Rectangle {
    in property <bool> one;
    callback picked(bool);
    width: 200px;
    height: 38px;
    border-radius: 10px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        SegTab {
            text: "Otomatis";
            on: !root.one;
            clicked => {
                root.picked(false);
            }
        }
        SegTab {
            text: "1 ayat/slide";
            on: root.one;
            clicked => {
                root.picked(true);
            }
        }
    }
}

// Satu referensi di "Terakhir dibuka".
component HistoryRowView inherits Rectangle {
    in property <HistoryRow> entry;
    in property <bool> current;
