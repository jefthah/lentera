component Icon inherits Path {
    in property <string> svg;
    in property <color> color: Theme.text;
    in property <bool> filled;
    commands: root.svg;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    stroke: root.filled ? transparent : root.color;
    fill: root.filled ? root.color : transparent;
    stroke-width: 1.8px;
    stroke-line-cap: round;
}

component Kbd inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-2;
    in property <color> outline: #343B4A;
    height: 20px;
    width: label.preferred-width + 12px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.outline;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> icon-filled;
    // "primary", "secondary", "ghost", atau "danger".
    in property <string> kind: "secondary";
    in property <string> kbd;
    in property <bool> on;
    in property <length> font-size: 14px;
    in property <length> pad: 14px;
    // Teks tidak boleh dipotong; ruang diambil dari elemen lain di baris.
    in property <bool> full-text;
    callback clicked();
    property <color> fg: root.kind == "primary" ? Theme.on-accent : root.kind == "danger" ? Theme.danger : Theme.text;
    height: 44px;
    border-radius: 12px;
    background: root.kind == "primary"
        ? (touch.pressed ? Theme.accent.darker(0.15) : touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : root.on ? Theme.accent-soft
        : root.kind == "ghost" || root.kind == "danger" ? (touch.has-hover ? Theme.hover : transparent)
        : (touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : Theme.raised);
    border-width: root.kind == "primary" || root.kind == "ghost" ? 0px : 1px;
    border-color: root.on ? Theme.accent : root.kind == "danger" ? #4A2A2E : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        alignment: center;
        spacing: root.pad < 14px ? 6px : 8px;
        padding-left: root.pad;
        padding-right: root.pad;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                svg: root.icon;
                color: root.fg;
                filled: root.icon-filled;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            min-width: root.full-text ? self.preferred-width : 0px;
        }
        if root.kbd != "": VerticalLayout {
            alignment: center;
            Kbd {
                text: root.kbd;
                ink: root.kind == "primary" ? Theme.on-accent : Theme.text-2;
                outline: root.kind == "primary" ? #1A120455 : #343B4A;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <length> size: 36px;
    in property <color> tint: Theme.text-2;
    in property <bool> bordered: true;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: 10px;
    background: touch.pressed ? Theme.active : touch.has-hover ? #262B36 : (root.bordered ? Theme.raised : transparent);
    border-width: root.bordered ? 1px : 0px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        svg: root.icon;
        color: touch.has-hover ? Theme.text : root.tint;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 26px;
    border-radius: 16px;
    background: root.on ? #232835 : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.on ? #3A4150 : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.on ? Theme.text : Theme.text-2;
        font-size: 13px;
        font-weight: root.on ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Teks slide yang ukurannya menyesuaikan kotak, seperti di layar proyektor.
component SlideText inherits Rectangle {
    in property <string> text;
    in property <int> lines: 1;
    in property <int> chars: 10;
    in property <color> ink;
    // Garis tepi gelap, untuk teks di atas gambar latar.
    in property <bool> outline;
    Text {
        x: parent.width * 0.06;
        y: parent.height * 0.08;
        width: parent.width * 0.88;
        height: parent.height * 0.84;
        text: root.text;
        color: root.ink;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 700;
        font-size: Math.min(
            parent.height * 0.84 / (Math.max(root.lines, 1) * 1.32),
            parent.width * 0.88 / (Math.max(root.chars, 10) * 0.55),
            parent.height / 6.5);
        stroke: root.outline ? Theme.picture-outline : transparent;
        stroke-width: root.outline ? Math.max(self.font-size * 0.07, 1px) : 0px;
        stroke-style: outside;
    }
}

// Gambar latar yang menutup seluruh slide, sedikit digelapkan.
component PictureFill inherits Rectangle {
    in property <image> picture;
    background: #000000;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.picture;
        image-fit: cover;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.picture-dim;
    }
}

component SlideTileView inherits Rectangle {
    in property <SlideTile> tile;
    in property <int> number;
    in property <bool> preview;
    in property <bool> live;
    in property <int> bg-index;
    in property <image> picture;
    in property <bool> has-picture;
    callback clicked();
    callback activated();
    property <length> thumb-h: self.width * 9 / 16;
    height: self.thumb-h + 30px;
    accessible-role: button;
    accessible-label: "Slide " + root.number + ": " + root.tile.first;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.thumb-h;
        border-radius: 14px;
        border-width: root.live || root.preview ? 2px : 1px;
        border-color: root.live ? Theme.live : root.preview ? Theme.accent : touch.has-hover ? #3A4150 : #2A303C;
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-radius: 10px;
            clip: true;
            background: Theme.slide-bg[root.bg-index];
            if root.has-picture: PictureFill {
                width: parent.width;
                height: parent.height;
                picture: root.picture;
            }
            SlideText {
                width: parent.width;
                height: parent.height;
                text: root.tile.text;
                lines: root.tile.lines;
                chars: root.tile.chars;
                ink: root.has-picture ? Theme.picture-ink : Theme.slide-ink[root.bg-index];
                outline: root.has-picture;
            }
            if root.live || root.preview: Rectangle {
                x: 8px;
                y: 8px;
                height: 22px;
                width: badge.preferred-width + 16px;
                border-radius: 6px;
                background: root.live ? Theme.live-badge : Theme.accent;
                badge := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.live ? "Tayang" : "Pratinjau";
                    color: root.live ? #FFFFFF : Theme.on-accent;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    HorizontalLayout {
        y: root.thumb-h + 8px;
        height: 20px;
        width: parent.width;
        spacing: 8px;
        padding-left: 2px;
        Text {
            text: root.number;
            color: #C5CBD6;
            font-size: 13px;
            font-weight: 600;
        }
        Text {
            text: root.tile.first;
            color: Theme.text-3;
            font-size: 13px;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.activated();
        }
    }
}

// Layar kecil di kolom kanan: pratinjau atau yang sedang tayang.
component Screen inherits Rectangle {
    in property <SlideTile> tile;
    in property <bool> has-slide;
    in property <bool> dark;
    in property <int> bg-index;
    in property <image> picture;
    in property <bool> has-picture;
    in property <color> ring;
    in property <string> empty-text;
    border-radius: 14px;
    border-width: 2px;
    border-color: root.ring;
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: 10px;
        clip: true;
        background: root.dark ? #000000 : Theme.slide-bg[root.bg-index];
        if root.has-picture && !root.dark: PictureFill {
            width: parent.width;
            height: parent.height;
            picture: root.picture;
        }
        if root.has-slide && !root.dark: SlideText {
            width: parent.width;
            height: parent.height;
            text: root.tile.text;
            lines: root.tile.lines;
            chars: root.tile.chars;
            ink: root.has-picture ? Theme.picture-ink : Theme.slide-ink[root.bg-index];
            outline: root.has-picture;
        }
        if root.dark || !root.has-slide: Text {
            width: parent.width;
            height: parent.height;
            text: root.dark ? "Layar jemaat gelap" : root.empty-text;
            color: root.has-picture && !root.dark ? #FFFFFFCC : root.bg-index == 2 && !root.dark ? #6B6A63 : Theme.text-3;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ServiceRowView inherits Rectangle {
    in property <ServiceRow> entry;
    in property <int> index;
    in property <bool> selected;
    in property <bool> on-air;
    callback clicked();
    callback activated();
    callback up();
    callback down();
    callback remove();
    height: 58px;
    border-radius: 12px;
    background: root.selected ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.selected ? Theme.active-border : transparent;
    accessible-role: list-item;
    accessible-label: (root.index + 1) + ". " + root.entry.title;
    accessible-action-default => {
        root.clicked();
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.activated();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 10px;
        Text {
            width: 20px;
            text: (root.index + 1 < 10 ? "0" : "") + (root.index + 1);
            color: Theme.num;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: root.entry.song ? Theme.accent-soft : Theme.verse-soft;
                Icon {
                    svg: root.entry.song ? Icons.music : Icons.book;
                    color: root.entry.song ? Theme.accent : Theme.verse;
                    width: 17px;
                    height: 17px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.entry.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.entry.meta;
                color: Theme.text-3;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.on-air && !root.selected: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: 70px;
                border-radius: 11px;
                background: Theme.live-badge;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #FFFFFF;
                        }
                    }
                    Text {
                        text: "Tayang";
                        color: #FFFFFF;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if root.selected: HorizontalLayout {
            spacing: 0px;
            if root.on-air: VerticalLayout {
                alignment: center;
                padding-right: 4px;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.live;
                }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.up;
                    label: "Naikkan";
                    size: 30px;
                    bordered: false;
                    clicked => {
                        root.up();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.down;
                    label: "Turunkan";
                    size: 30px;
                    bordered: false;
                    clicked => {
                        root.down();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.close;
                    label: "Lepas dari susunan";
                    size: 30px;
                    bordered: false;
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
    }
}

component LibraryRowView inherits Rectangle {
    in property <LibraryRow> entry;
    in property <bool> selected;
    callback clicked();
    callback activated();
    callback add();
    height: 52px;
    border-radius: 10px;
    background: root.selected ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-action-default => {
        root.clicked();
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.activated();
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.entry.song ? Theme.accent : Theme.verse;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.entry.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: root.selected ? 600 : 400;
                overflow: elide;
            }
            Text {
                text: root.entry.meta;
                color: Theme.text-3;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            IconBtn {
                icon: Icons.plus;
                label: "Tambah ke susunan";
                clicked => {
                    root.add();
                }
            }
        }
    }
}

// Tab di kolom kiri (Pustaka / Alkitab).
component TabBtn inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 34px;
    width: label.preferred-width + 24px;
    border-radius: 9px;
    background: root.on ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.on ? Theme.text : Theme.text-2;
        font-size: 15px;
        font-weight: root.on ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        x: 10px;
        width: parent.width - 20px;
        height: 2px;
        border-radius: 1px;
        background: root.on ? Theme.accent : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Satu ayat di daftar pasal. Shift+klik memilih rentang.
component VerseRowView inherits Rectangle {
    in property <VerseRow> entry;
    // Argumen: Shift ditekan.
    callback clicked(bool);
    callback activated();
    property <bool> shift;
    height: 46px;
    border-radius: 8px;
    clip: true;
    background: root.entry.picked ? Theme.verse-soft : touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.entry.number + " " + root.entry.text;
    accessible-checked: root.entry.picked;
    accessible-action-default => {
        root.clicked(false);
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.shift = event.modifiers.shift;
            }
        }
        clicked => {
            root.clicked(root.shift);
        }
        double-clicked => {
            root.activated();
        }
    }
    Rectangle {
        x: 0px;
        y: 7px;
        width: 3px;
        height: parent.height - 14px;
        border-radius: 2px;
        background: root.entry.picked ? Theme.verse : transparent;
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 4px;
        spacing: 8px;
        Text {
            width: 32px;
            text: root.entry.number;
            color: root.entry.picked ? Theme.verse : Theme.num;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: top;
        }
        // Teks sudah dipendekkan di Rust supaya muat dua baris; sisanya dipotong.
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.entry.text;
                color: root.entry.picked ? Theme.text : Theme.text-2;
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    callback clicked();
    height: 48px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    VerticalLayout {
        padding-left: 12px;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
        }
        Text {
            text: root.hint;
            color: Theme.text-3;
            font-size: 12px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Swatch inherits VerticalLayout {
    in property <int> index;
    in property <bool> on;
    callback clicked();
    spacing: 4px;
    Rectangle {
        height: 30px;
        border-radius: 9px;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? Theme.accent : #3A4150;
        accessible-role: button;
        accessible-label: "Latar " + Theme.slide-names[root.index];
        accessible-checked: root.on;
        accessible-action-default => {
            root.clicked();
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 6px;
            background: Theme.slide-bg[root.index];
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    Text {
        text: Theme.slide-names[root.index];
        color: root.on ? Theme.text : Theme.text-3;
        font-size: 12px;
        horizontal-alignment: center;
    }
}

// Pilihan "Gambar" di samping warna latar: gambar yang sedang dipakai, atau
// ikon gambar bila belum ada.
component PictureSwatch inherits VerticalLayout {
    in property <image> picture;
    in property <bool> on;
    callback clicked();
    spacing: 4px;
    Rectangle {
        height: 30px;
        border-radius: 9px;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? Theme.accent : #3A4150;
        accessible-role: button;
        accessible-label: "Latar gambar";
        accessible-checked: root.on;
        accessible-action-default => {
            root.clicked();
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 6px;
            clip: true;
            background: Theme.raised;
            if root.on: Image {
                width: parent.width;
                height: parent.height;
                source: root.picture;
                image-fit: cover;
            }
            if !root.on: Icon {
                svg: Icons.image;
                color: Theme.text-2;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    Text {
        text: "Gambar";
        color: root.on ? Theme.text : Theme.text-3;
        font-size: 12px;
        horizontal-alignment: center;
    }
}

component BackgroundThumb inherits Rectangle {
    in property <BackgroundTile> tile;
    callback clicked();
    callback remove();
    height: self.width * 9 / 16 + 24px;
    frame := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.width * 9 / 16;
        border-radius: 10px;
        border-width: root.tile.on ? 2px : 1px;
        border-color: root.tile.on ? Theme.accent : touch.has-hover ? #4A5263 : #2A303C;
        accessible-role: button;
        accessible-label: "Latar " + root.tile.label;
        accessible-checked: root.tile.on;
        accessible-action-default => {
            root.clicked();
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 7px;
            clip: true;
            background: #000000;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.tile.picture;
                image-fit: cover;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
        IconBtn {
            x: parent.width - self.width - 6px;
            y: 6px;
            size: 28px;
            icon: Icons.trash;
            label: "Hapus latar " + root.tile.label;
            clicked => {
                root.remove();
            }
        }
    }
    Text {
        x: 2px;
        y: frame.height + 5px;
        width: parent.width - 4px;
        text: root.tile.label;
        color: root.tile.on ? Theme.text : Theme.text-3;
        font-size: 12px;
        overflow: elide;
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> detail;
    padding-left: 6px;
    padding-right: 6px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        text: root.detail;
        color: Theme.text-3;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// Lingkaran berisi huruf pertama nama profil.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <int> tone;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Theme.avatar[root.tone];
    Text {
        width: parent.width;
        height: parent.height;
        text: root.initial;
        color: Theme.on-accent;
        font-size: root.size * 0.44;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Tombol profil di bilah atas; membuka layar pilih profil.
component ProfileChip inherits Rectangle {
    in property <string> name;
    in property <string> initial;
    in property <int> tone;
    // Hanya lingkaran dan panah, untuk jendela sempit.
    in property <bool> compact;
    callback clicked();
    height: 40px;
    max-width: 220px;
    preferred-width: chip-row.preferred-width;
    border-radius: 12px;
    background: touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border : transparent;
    accessible-role: button;
    accessible-label: "Profil " + root.name + ". Ganti profil";
    accessible-action-default => {
        root.clicked();
    }
    chip-row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Avatar {
                initial: root.initial;
                tone: root.tone;
                size: 28px;
            }
        }
        if !root.compact: Text {
            horizontal-stretch: 1;
            text: root.name;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                svg: Icons.chevron;
                color: Theme.text-3;
                width: 14px;
                height: 14px;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ProfileCardView inherits Rectangle {
    in property <ProfileCard> card;
    callback clicked();
    callback rename();
    callback remove();
    border-radius: 16px;
    background: touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : Theme.raised;
    border-width: root.card.current ? 2px : 1px;
    border-color: root.card.current ? Theme.accent : touch.has-hover ? Theme.active-border : Theme.border;
    accessible-role: button;
    accessible-label: "Buka profil " + root.card.name;
    accessible-action-default => {
        root.clicked();
    }
    // Di bawah tombol ganti nama dan hapus, supaya klik keduanya tidak membuka profil.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding: 16px;
        padding-top: 22px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Avatar {
                initial: root.card.initial;
                tone: root.card.tone;
                size: 68px;
            }
        }
        Text {
            height: 42px;
            text: root.card.name;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        Text {
            text: root.card.detail;
            color: root.card.current ? Theme.accent : Theme.text-3;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            IconBtn {
                icon: Icons.edit;
                label: "Ganti nama profil " + root.card.name;
                size: 32px;
                bordered: false;
                clicked => {
                    root.rename();
                }
            }
            if !root.card.current: IconBtn {
                icon: Icons.trash;
                label: "Hapus profil " + root.card.name;
                size: 32px;
                bordered: false;
                tint: Theme.danger;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

component NewProfileCard inherits Rectangle {
    callback clicked();
    border-radius: 16px;
    background: touch.pressed ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: "Profil baru";
    accessible-action-default => {
        root.clicked();
    }
    VerticalLayout {
        padding: 16px;
        padding-top: 22px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 68px;
                height: 68px;
                border-radius: 34px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border;
                Icon {
                    svg: Icons.plus;
                    color: Theme.accent;
                    width: 26px;
                    height: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        Text {
            text: "Profil baru";
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "Mulai dari pustaka kosong";
            color: Theme.text-3;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Layar pilih profil: menutupi seluruh jendela operator. Juga dipakai untuk
// membuat profil baru dan mengganti nama profil.
component ProfileScreen inherits Rectangle {
    in property <[ProfileCard]> profiles;
    in property <string> current-name;
    // 0: daftar profil, 1: profil baru, 2: ganti nama.
    in-out property <int> form;
    in-out property <string> form-name;
    in-out property <string> form-target;
    in-out property <string> form-error;
    callback choose(string);
    callback close();
    callback submit();
    callback remove(string);
    background: Theme.bg;

    // Menahan klik supaya tidak sampai ke layar operator di belakangnya.
    TouchArea { }

    VerticalLayout {
        padding: 28px;
        padding-bottom: 32px;
        spacing: 22px;
        HorizontalLayout {
            alignment: end;
            IconBtn {
                icon: Icons.close;
                label: "Tutup pilihan profil";
                size: 40px;
                clicked => {
                    root.close();
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../assets/icon/lentera.svg");
                    width: 56px;
                    height: 56px;
                }
            }
            Text {
                text: root.form == 1 ? "Profil baru" : root.form == 2 ? "Ganti nama profil" : "Pilih profil";
                color: Theme.text;
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.form == 1
                    ? "Profil baru dimulai dengan pustaka kosong. Latar dan monitor proyektor mengikuti yang sekarang."
                    : root.form == 2 ? "Nama ini tampil di bilah atas dan di daftar profil."
                    : "Setiap profil punya pustaka lirik, ayat, dan susunan ibadahnya sendiri.";
                color: Theme.text-2;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if root.form == 0: cards := ScrollView {
            vertical-stretch: 1;
            property <length> card-w: 190px;
            property <length> card-h: 224px;
            property <length> gap: 18px;
            property <int> count: root.profiles.length + 1;
            property <int> cols: Math.max(1, Math.min(self.count, Math.floor((self.visible-width + self.gap) / (self.card-w + self.gap))));
            property <length> left: Math.max(0px, (self.visible-width - (self.cols * (self.card-w + self.gap) - self.gap)) / 2);
            content-width: self.visible-width;
            content-height: Math.ceil(self.count / self.cols) * (self.card-h + self.gap);
            for card[i] in root.profiles: ProfileCardView {
                x: cards.left + Math.mod(i, cards.cols) * (cards.card-w + cards.gap);
                y: Math.floor(i / cards.cols) * (cards.card-h + cards.gap);
                width: cards.card-w;
                height: cards.card-h;
                card: card;
                clicked => {
                    root.choose(card.id);
                }
                rename => {
                    root.form-target = card.id;
                    root.form-name = card.name;
                    root.form-error = "";
                    root.form = 2;
                }
                remove => {
                    root.remove(card.id);
                }
            }
            NewProfileCard {
                x: cards.left + Math.mod(root.profiles.length, cards.cols) * (cards.card-w + cards.gap);
                y: Math.floor(root.profiles.length / cards.cols) * (cards.card-h + cards.gap);
                width: cards.card-w;
                height: cards.card-h;
                clicked => {
                    root.form-target = "";
                    root.form-name = "";
                    root.form-error = "";
                    root.form = 1;
                }
            }
        }
        if root.form != 0: HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;
            VerticalLayout {
                width: 420px;
                alignment: start;
                spacing: 10px;
                Text {
                    text: "Nama profil";
                    color: Theme.text-2;
                    font-size: 13px;
                }
                LineEdit {
                    placeholder-text: "Misalnya: Ibadah Umum, Komisi Pemuda";
                    text <=> root.form-name;
                    init => {
                        self.focus();
                    }
                    accepted => {
                        root.submit();
                    }
                }
                if root.form-error != "": Text {
                    text: root.form-error;
                    color: Theme.danger;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 6px;
                    Btn {
                        text: "Batal";
                        kind: "ghost";
                        clicked => {
                            root.form = 0;
                        }
                    }
                    Btn {
                        text: root.form == 1 ? "Buat dan buka" : "Simpan nama";
                        icon: Icons.check;
                        kind: "primary";
                        clicked => {
                            root.submit();
                        }
                    }
                }
            }
        }
        if root.form == 0: Text {
            text: "Sedang dibuka: " + root.current-name + "  ·  Esc untuk kembali";
            color: Theme.text-3;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    in property <string> version;

    in property <[LibraryRow]> library;
    in property <string> library-detail;
    in property <[ServiceRow]> service;
    in property <[SlideTile]> slides;
    in property <int> selected-id: -1;
    in property <int> selected-service: -1;

    in property <bool> has-current;
    in property <string> current-title;
    in property <string> current-meta;
    in property <int> preview-page;
    in property <bool> has-preview;
    in property <SlideTile> preview;
    in property <string> preview-meta;

    in property <bool> has-live;
    in property <SlideTile> live;
    in property <string> live-meta: "Belum ada yang tayang";
    in property <int> live-item-id: -1;
    in property <int> live-page: -1;
    in property <int> live-service: -1;
    in property <bool> blackout;
    in property <bool> output-visible;
    in property <bool> fullscreen;
    in property <int> bg-index;
    // Gambar latar yang dipakai, dan daftar gambar latar profil.
    in property <image> bg-picture;
    in property <bool> has-bg-picture;
    in property <[BackgroundTile]> backgrounds;
    in property <[string]> monitors;
    in-out property <int> monitor-index;

    in-out property <string> query;
    in-out property <int> filter;
    // Kolom kiri: 0 Pustaka, 1 Alkitab.
    in-out property <int> left-tab;

    // Tab Alkitab.
    in property <[string]> bible-translations;
    in-out property <int> bible-translation;
    in-out property <string> bible-ref;
    in property <string> bible-label;
    in property <string> bible-detail;
    in property <string> bible-error;
    in property <bool> bible-has-passage;
    in property <string> bible-chapter-title;
    in property <[VerseRow]> bible-verses;
    in-out property <bool> bible-one-per-slide;
    // Daftar ayat digulir ke baris ini setiap kali serial berubah.
    in property <int> bible-scroll-row;
    in property <int> bible-scroll-serial;
    in property <bool> bible-importing;
    in property <string> bible-import-info;
    in-out property <string> bible-import-code;
    in-out property <string> bible-import-name;
    in property <string> bible-import-error;

    in property <bool> editing;
    in property <bool> focus-title;
    in-out property <string> editor-title;
    in-out property <string> editor-body;
    in property <bool> editor-song: true;
    in property <[SlideTile]> editor-slides;

    in property <string> status: "Tersimpan otomatis";
    in property <bool> status-ok: true;
    in property <string> update-version;

    // Profil yang sedang dibuka dan layar pilih profil.
    in property <string> profile-name;
    in property <string> profile-initial;
    in property <int> profile-tone;
    in property <[ProfileCard]> profiles;
    in property <bool> picking-profile;
    in-out property <int> profile-form;
    in-out property <string> profile-form-name;
    in-out property <string> profile-form-target;
    in-out property <string> profile-form-error;

    callback search-changed();
    callback filter-changed(int);
    callback select-library(int);
    callback activate-library(int);
    callback add-to-service(int);
    callback select-service(int);
    callback activate-service(int);
    callback move-service(int, int);
    callback remove-service(int);
    callback select-slide(int);
    callback activate-slide(int);
    callback go-live();
    callback navigate(bool);
    callback toggle-blackout();
    callback toggle-fullscreen();
    callback toggle-projector();
    callback escape();
    callback monitor-changed(int);
    callback background-changed(int);
    callback show-backgrounds();
    callback pick-background(string);
    callback add-backgrounds();
    callback remove-background(string);
    callback new-item();
    callback edit-current();
    callback close-editor();
    callback editor-edited();
    callback set-song(bool);
    callback add-current-to-service();
    callback delete-current();
    callback save-now();
    callback import-lyrics();
    callback import-easyworship();
    callback import-verses();
    callback update-now();
    callback show-profiles();
    callback close-profiles();
    callback choose-profile(string);
    callback submit-profile-form();
    callback delete-profile(string);
    callback left-tab-changed(int);
    callback bible-translation-changed(int);
    callback bible-ref-edited();
    callback bible-go-live();
    callback bible-verse-clicked(int, bool);
    callback bible-verse-activated(int);
    callback bible-add-to-service();
    callback bible-packing-changed();
    callback bible-import();
    callback bible-import-save();
    callback bible-import-cancel();
    callback bible-remove-translation();

    // Fokus kembali ke pintasan papan ketik saat layar profil dibuka, ditutup,
    // atau formulirnya selesai.
    // Di bawah 1200 px nama profil memakan tempat tombol proyektor dan impor,
    // jadi tombol profil diringkas (namanya tetap ada di judul jendela). Diisi
    // lewat `changed`, bukan binding, karena lebar jendela ikut ditentukan isi
    // bilah atas.
    property <bool> compact-bar;
    changed width => {
        self.compact-bar = self.width < 1200px;
    }
    changed picking-profile => {
        keys.focus();
    }
    changed profile-form => {
        if self.profile-form == 0 {
            keys.focus();
        }
    }

    public function close-about() {
        about-popup.close();
    }
    public function show-about() {
        about-popup.show();
    }

    public function open-backgrounds() {
        bg-popup.show();
    }
    public function close-backgrounds() {
        bg-popup.close();
    }
    public function show-import-menu() {
        import-menu.show();
    }

    public function close-import-menu() {
        import-menu.close();
    }

    title: "Lentera " + root.version + (root.profile-name == "" ? "" : " · " + root.profile-name);
    preferred-width: 1360px;
    preferred-height: 840px;
    min-width: 1024px;
    min-height: 640px;
    background: Theme.bg;
    default-font-size: 14px;

    init => {
        self.compact-bar = self.width < 1200px;
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if root.picking-profile {
                if event.text == Key.Escape {
                    root.escape();
                    return accept;
                }
                return reject;
            }
            if event.text == Key.F5 || (event.modifiers.control && event.text == Key.Return) {
                root.go-live();
                return accept;
            }
            if event.text == Key.F6 {
                root.toggle-blackout();
                return accept;
            }
            if event.text == Key.F11 {
                root.toggle-fullscreen();
                return accept;
            }
            if event.text == Key.PageDown {
                root.navigate(true);
                return accept;
            }
            if event.text == Key.PageUp {
                root.navigate(false);
                return accept;
            }
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            if event.modifiers.control && (event.text == "s" || event.text == "S") {
                root.save-now();
                return accept;
            }
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                root.new-item();
                return accept;
            }
            if self.has-focus && (event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == " ") {
                root.navigate(true);
                return accept;
            }
            if self.has-focus && (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.navigate(false);
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Bilah atas.
            Rectangle {
                height: 62px;
                background: Theme.bar;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 16px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icon/lentera.svg");
                                width: 36px;
                                height: 36px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ProfileChip {
                                compact: root.compact-bar;
                                name: root.profile-name;
                                initial: root.profile-initial;
                                tone: root.profile-tone;
                                clicked => {
                                    root.show-profiles();
                                }
                            }
                        }
                    }
                    if root.editing: VerticalLayout {
                        alignment: center;
                        Btn {
                            text: "Kembali ke tayang";
                            icon: Icons.back;
                            clicked => {
                                root.close-editor();
                                keys.focus();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 260px;
                        preferred-width: 440px;
                        max-width: 520px;
                        LineEdit {
                            placeholder-text: "Cari lagu, ayat, atau isi";
                            text <=> root.query;
                            edited => {
                                root.search-changed();
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if !root.editing: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                text: root.output-visible ? "Tutup proyektor" : "Buka proyektor";
                                full-text: true;
                                icon: Icons.monitor;
                                on: root.output-visible;
                                clicked => {
                                    root.toggle-projector();
                                    keys.focus();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ComboBox {
                                width: 230px;
                                model: root.monitors;
                                current-index <=> root.monitor-index;
                                selected => {
                                    root.monitor-changed(self.current-index);
                                    keys.focus();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            import-btn := Btn {
                                text: "Impor";
                                full-text: true;
                                icon: Icons.import;
                                clicked => {
                                    import-menu.show();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                icon: Icons.info;
                                label: "Tentang Lentera";
                                size: 44px;
                                clicked => {
                                    about-popup.show();
                                }
                            }
                        }
                    }
                    if root.editing && root.has-live: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 40px;
                            width: live-pill.preferred-width + 36px;
                            border-radius: 12px;
                            background: Theme.live-soft;
                            border-width: 1px;
                            border-color: #5A2226;
                            HorizontalLayout {
                                padding-left: 14px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: #FF5A60;
                                    }
                                }
                                live-pill := Text {
                                    text: root.blackout ? "Layar jemaat sedang gelap" : "Sedang tayang: " + root.live-meta;
                                    color: #FFC9CB;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
                import-menu := PopupWindow {
                    x: parent.width - 312px;
                    y: parent.height - 4px;
                    width: 264px;
                    Rectangle {
                        background: Theme.raised;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            MenuRow {
                                text: "Lirik lagu (.txt)";
                                hint: "Baris kosong memisahkan slide";
                                clicked => {
                                    import-menu.close();
                                    root.import-lyrics();
                                }
                            }
                            MenuRow {
                                text: "Lagu dari EasyWorship";
                                hint: "Semua lagu sekaligus, EW 2009 sampai 8";
                                clicked => {
                                    import-menu.close();
                                    root.import-easyworship();
                                }
                            }
                            MenuRow {
                                text: "Ayat Alkitab (.tsv)";
                                hint: "referensi [TAB] teks, UTF-8";
                                clicked => {
                                    import-menu.close();
                                    root.import-verses();
                                }
                            }
                            MenuRow {
                                text: "Alkitab lengkap";
                                hint: "OpenSong, Zefania, TSV, EasyWorship";
                                clicked => {
                                    import-menu.close();
                                    root.bible-import();
                                }
                            }
                        }
                    }
                }
                // Tentang Lentera. Widget AboutSlint wajib tampil di sini sebagai
                // atribusi lisensi Slint Royalty-free 2.0.
                about-popup := PopupWindow {
                    x: (parent.width - 460px) / 2;
                    y: 96px;
                    width: 460px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: Theme.raised;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icon/lentera.svg");
                                        width: 52px;
                                        height: 52px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Lentera";
                                        color: Theme.text;
                                        font-size: 20px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Versi " + root.version;
                                        color: Theme.text-3;
                                        font-size: 13px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    IconBtn {
                                        icon: Icons.close;
                                        label: "Tutup";
                                        size: 32px;
                                        bordered: false;
                                        clicked => {
                                            about-popup.close();
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "Presentasi ibadah yang ringan untuk Windows dan macOS. Kode sumber berlisensi MIT di github.com/jefthah/lentera.";
                                color: Theme.text-2;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Komponen pihak ketiga dan lisensinya tercantum di THIRD-PARTY-NOTICES.txt di folder program.";
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }
                            AboutSlint { }
                        }
                    }
                }
                // Daftar gambar latar profil.
                bg-popup := PopupWindow {
                    x: (parent.width - self.width) / 2;
                    y: 72px;
                    width: Math.min(640px, root.width - 48px);
                    height: Math.min(560px, root.height - 120px);
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: Theme.raised;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Latar gambar";
                                        color: Theme.text;
                                        font-size: 18px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: root.backgrounds.length == 0 ? "Belum ada gambar di profil ini" : root.backgrounds.length + " gambar di profil ini";
                                        color: Theme.text-3;
                                        font-size: 12px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Btn {
                                        text: "Tambah gambar";
                                        icon: Icons.plus;
                                        font-size: 13px;
                                        full-text: true;
                                        clicked => {
                                            root.add-backgrounds();
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        icon: Icons.close;
                                        label: "Tutup";
                                        size: 32px;
                                        bordered: false;
                                        clicked => {
                                            bg-popup.close();
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "Klik gambar untuk memakainya di layar jemaat. Lirik tampil putih dengan garis tepi gelap. Gambar JPG atau PNG disalin ke profil ini; berkas aslinya tidak diubah.";
                                color: Theme.text-2;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            if root.backgrounds.length == 0: Rectangle {
                                vertical-stretch: 1;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border;
                                Text {
                                    x: 24px;
                                    width: parent.width - 48px;
                                    text: "Klik Tambah gambar untuk memilih satu atau beberapa gambar sekaligus, misalnya dari folder gambar EasyWorship.";
                                    color: Theme.text-3;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                            if root.backgrounds.length > 0: gallery := ScrollView {
                                vertical-stretch: 1;
                                property <int> cols: 4;
                                property <length> tile-w: (self.visible-width - (self.cols - 1) * 12px) / self.cols;
                                property <length> tile-h: self.tile-w * 9 / 16 + 24px;
                                content-width: self.visible-width;
                                content-height: Math.ceil(root.backgrounds.length / self.cols) * (self.tile-h + 12px);
                                for tile[i] in root.backgrounds: BackgroundThumb {
                                    x: Math.mod(i, gallery.cols) * (gallery.tile-w + 12px);
                                    y: Math.floor(i / gallery.cols) * (gallery.tile-h + 12px);
                                    width: gallery.tile-w;
                                    tile: tile;
                                    clicked => {
                                        root.pick-background(tile.name);
                                    }
                                    remove => {
                                        root.remove-background(tile.name);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                // Kolom kiri: susunan ibadah dan pustaka.
                Rectangle {
                    width: 310px;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 14px;
                        padding-top: 18px;
                        spacing: 8px;
                        SectionTitle {
                            text: "Susunan ibadah";
                            detail: root.service.length + " materi";
                        }
                        if root.service.length == 0: Text {
                            text: "Belum ada materi. Tekan + di pustaka untuk menambahkan.";
                            color: Theme.text-3;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        ListView {
                            vertical-stretch: 1;
                            min-height: 120px;
                            for row[i] in root.service: ServiceRowView {
                                entry: row;
                                index: i;
                                selected: i == root.selected-service;
                                on-air: i == root.live-service && !root.blackout;
                                clicked => {
                                    keys.focus();
                                    root.select-service(i);
                                }
                                activated => {
                                    root.activate-service(i);
                                }
                                up => {
                                    root.move-service(i, -1);
                                }
                                down => {
                                    root.move-service(i, 1);
                                }
                                remove => {
                                    root.remove-service(i);
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.line;
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            spacing: 4px;
                            TabBtn {
                                text: "Pustaka";
                                on: root.left-tab == 0;
                                clicked => {
                                    root.left-tab = 0;
                                    root.left-tab-changed(0);
                                }
                            }
                            TabBtn {
                                text: "Alkitab";
                                on: root.left-tab == 1;
                                clicked => {
                                    root.left-tab = 1;
                                    root.left-tab-changed(1);
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            if root.left-tab == 0: Btn {
                                text: "Materi baru";
                                icon: Icons.plus;
                                kind: "ghost";
                                height: 34px;
                                font-size: 13px;
                                clicked => {
                                    root.new-item();
                                }
                            }
                        }
                        if root.left-tab == 0: HorizontalLayout {
                            spacing: 6px;
                            padding-left: 4px;
                            Chip {
                                text: "Semua";
                                on: root.filter == 0;
                                clicked => {
                                    root.filter = 0;
                                    root.filter-changed(0);
                                }
                            }
                            Chip {
                                text: "Lagu";
                                on: root.filter == 1;
                                clicked => {
                                    root.filter = 1;
                                    root.filter-changed(1);
                                }
                            }
                            Chip {
                                text: "Ayat";
                                on: root.filter == 2;
                                clicked => {
                                    root.filter = 2;
                                    root.filter-changed(2);
                                }
                            }
                            Text {
                                text: root.library-detail;
                                color: Theme.text-3;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        if root.left-tab == 0 && root.library.length == 0: Text {
                            text: root.query == "" ? "Pustaka masih kosong." : "Tidak ada yang cocok dengan pencarian.";
                            color: Theme.text-3;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.left-tab == 0: ListView {
                            vertical-stretch: 1.5;
                            min-height: 150px;
                            for row in root.library: LibraryRowView {
                                entry: row;
                                selected: row.id == root.selected-id;
                                clicked => {
                                    keys.focus();
                                    root.select-library(row.id);
                                }
                                activated => {
                                    root.activate-library(row.id);
                                }
                                add => {
                                    root.add-to-service(row.id);
                                }
                            }
                        }
                        // Tab Alkitab: formulir impor.
                        if root.left-tab == 1 && root.bible-importing: VerticalLayout {
                            vertical-stretch: 1.5;
                            spacing: 8px;
                            padding-left: 4px;
                            padding-right: 4px;
                            Text {
                                text: "Impor Alkitab";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.bible-import-info;
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Singkatan, ditulis di judul ayat";
                                color: Theme.text-2;
                                font-size: 12px;
                            }
                            LineEdit {
                                placeholder-text: "misalnya TB";
                                text <=> root.bible-import-code;
                                accepted => {
                                    root.bible-import-save();
                                }
                            }
                            Text {
                                text: "Nama terjemahan";
                                color: Theme.text-2;
                                font-size: 12px;
                            }
                            LineEdit {
                                placeholder-text: "misalnya Terjemahan Baru";
                                text <=> root.bible-import-name;
                                accepted => {
                                    root.bible-import-save();
                                }
                            }
                            if root.bible-import-error != "": Text {
                                text: root.bible-import-error;
                                color: Theme.danger;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Gunakan hanya terjemahan yang Anda berhak pakai.";
                                color: Theme.text-3;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Btn {
                                    text: "Batal";
                                    kind: "ghost";
                                    height: 38px;
                                    font-size: 13px;
                                    clicked => {
                                        root.bible-import-cancel();
                                    }
                                }
                                Btn {
                                    text: "Simpan";
                                    icon: Icons.check;
                                    kind: "primary";
                                    height: 38px;
                                    font-size: 13px;
                                    clicked => {
                                        root.bible-import-save();
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                            }
                        }
                        // Tab Alkitab: belum ada terjemahan.
                        if root.left-tab == 1 && !root.bible-importing && root.bible-translations.length == 0: VerticalLayout {
                            vertical-stretch: 1.5;
                            spacing: 10px;
                            padding-left: 4px;
                            padding-right: 4px;
                            Text {
                                text: "Belum ada Alkitab di komputer ini.";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Impor sekali dari berkas OpenSong XML, Zefania XML, atau TSV yang Anda berhak gunakan. Setelah itu cukup ketik referensi, misalnya Yoh 3:16-18.";
                                color: Theme.text-3;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                Btn {
                                    text: "Impor Alkitab";
                                    icon: Icons.import;
                                    full-text: true;
                                    height: 38px;
                                    font-size: 13px;
                                    clicked => {
                                        root.bible-import();
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                            }
                        }
                        // Tab Alkitab: cari dan pilih ayat.
                        if root.left-tab == 1 && !root.bible-importing && root.bible-translations.length > 0: VerticalLayout {
                            vertical-stretch: 1.5;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: root.bible-translations;
                                    current-index <=> root.bible-translation;
                                    selected => {
                                        root.bible-translation-changed(self.current-index);
                                    }
                                }
                                IconBtn {
                                    icon: Icons.import;
                                    label: "Impor terjemahan lain";
                                    clicked => {
                                        root.bible-import();
                                    }
                                }
                                IconBtn {
                                    icon: Icons.trash;
                                    label: "Hapus terjemahan ini";
                                    clicked => {
                                        root.bible-remove-translation();
                                    }
                                }
                            }
                            LineEdit {
                                placeholder-text: "Ketik referensi, misalnya Yoh 3:16-18";
                                text <=> root.bible-ref;
                                edited => {
                                    root.bible-ref-edited();
                                }
                                accepted => {
                                    root.bible-go-live();
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                padding-left: 4px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: root.bible-error != "" ? root.bible-error : root.bible-label;
                                        color: root.bible-error != "" ? Theme.danger : Theme.text;
                                        font-size: 13px;
                                        font-weight: root.bible-error != "" ? 400 : 600;
                                        wrap: word-wrap;
                                    }
                                    if root.bible-error == "" && root.bible-detail != "": Text {
                                        text: root.bible-detail;
                                        color: Theme.text-3;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                if root.bible-has-passage: VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        text: "Susunan";
                                        icon: Icons.plus;
                                        full-text: true;
                                        height: 34px;
                                        font-size: 13px;
                                        pad: 10px;
                                        clicked => {
                                            root.bible-add-to-service();
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                padding-left: 4px;
                                Chip {
                                    text: "Otomatis";
                                    on: !root.bible-one-per-slide;
                                    clicked => {
                                        root.bible-one-per-slide = false;
                                        root.bible-packing-changed();
                                    }
                                }
                                Chip {
                                    text: "1 ayat/slide";
                                    on: root.bible-one-per-slide;
                                    clicked => {
                                        root.bible-one-per-slide = true;
                                        root.bible-packing-changed();
                                    }
                                }
                                Text {
                                    text: root.bible-chapter-title;
                                    color: Theme.text-3;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            ListView {
                                vertical-stretch: 1;
                                min-height: 120px;
                                property <int> serial: root.bible-scroll-serial;
                                changed serial => {
                                    // Satu ayat sebelum ayat terpilih ikut terlihat.
                                    self.content-y = -Math.min(
                                        Math.max(root.bible-scroll-row - 1, 0) * 46px,
                                        Math.max(self.content-height - self.visible-height, 0px));
                                }
                                for row[i] in root.bible-verses: VerseRowView {
                                    entry: row;
                                    clicked(shift) => {
                                        root.bible-verse-clicked(i, shift);
                                    }
                                    activated => {
                                        root.bible-verse-activated(i);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                }

                // Tengah, mode tayang: semua slide materi terpilih.
                if !root.editing: VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 24px;
                    padding-bottom: 14px;
                    spacing: 16px;
                    if root.has-current: HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.current-meta;
                                color: Theme.text-3;
                                font-size: 13px;
                            }
                            Text {
                                text: root.current-title;
                                color: Theme.text;
                                font-size: 24px;
                                font-weight: 700;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            Btn {
                                text: "Edit materi";
                                icon: Icons.edit;
                                clicked => {
                                    root.edit-current();
                                }
                            }
                        }
                    }
                    if root.has-current && root.slides.length > 0: grid := ScrollView {
                        vertical-stretch: 1;
                        property <int> cols: Math.max(1, Math.floor((self.visible-width + 20px) / 220px));
                        property <length> tile-w: (self.visible-width - (self.cols - 1) * 20px) / self.cols;
                        property <length> tile-h: self.tile-w * 9 / 16 + 30px;
                        content-width: self.visible-width;
                        content-height: Math.ceil(root.slides.length / self.cols) * (self.tile-h + 20px);
                        for tile[i] in root.slides: SlideTileView {
                            x: Math.mod(i, grid.cols) * (grid.tile-w + 20px);
                            y: Math.floor(i / grid.cols) * (grid.tile-h + 20px);
                            width: grid.tile-w;
                            tile: tile;
                            number: i + 1;
                            bg-index: root.bg-index;
                            picture: root.bg-picture;
                            has-picture: root.has-bg-picture;
                            preview: i == root.preview-page;
                            live: root.live-item-id == root.selected-id && i == root.live-page && !root.blackout;
                            clicked => {
                                keys.focus();
                                root.select-slide(i);
                            }
                            activated => {
                                root.activate-slide(i);
                            }
                        }
                    }
                    if root.has-current && root.slides.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text {
                            text: "Materi ini masih kosong. Tekan Edit materi untuk mengisi teks.";
                            color: Theme.text-3;
                            horizontal-alignment: center;
                        }
                    }
                    if !root.has-current: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "Pilih materi dari susunan atau pustaka";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Slide-nya akan tampil di sini untuk dipratinjau dan ditayangkan.";
                            color: Theme.text-3;
                            horizontal-alignment: center;
                        }
                    }
                    if root.has-current: Text {
                        text: "Klik slide untuk pratinjau, lalu Tayangkan. Klik dua kali untuk langsung menayangkan.";
                        color: Theme.text-3;
                        font-size: 13px;
                        overflow: elide;
                    }
                }

                // Tengah, mode edit.
                if root.editing: VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 24px;
                    padding-bottom: 14px;
                    spacing: 8px;
                    Text {
                        text: "Judul";
                        color: Theme.text-2;
                        font-size: 13px;
                    }
                    LineEdit {
                        text <=> root.editor-title;
                        font-size: 20px;
                        height: 46px;
                        init => {
                            if root.focus-title {
                                self.focus();
                                self.select-all();
                            }
                        }
                        edited => {
                            root.editor-edited();
                        }
                    }
                    HorizontalLayout {
                        padding-top: 8px;
                        padding-bottom: 6px;
                        spacing: 6px;
                        Text {
                            text: "Jenis";
                            color: Theme.text-2;
                            font-size: 13px;
                            vertical-alignment: center;
                            width: 50px;
                        }
                        Chip {
                            text: "Lirik lagu";
                            on: root.editor-song;
                            clicked => {
                                root.set-song(true);
                            }
                        }
                        Chip {
                            text: "Ayat Alkitab";
                            on: !root.editor-song;
                            clicked => {
                                root.set-song(false);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    Text {
                        text: "Isi";
                        color: Theme.text-2;
                        font-size: 13px;
                    }
                    TextEdit {
                        vertical-stretch: 1;
                        text <=> root.editor-body;
                        font-size: 16px;
                        wrap: word-wrap;
                        edited => {
                            root.editor-edited();
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Satu baris kosong memisahkan slide. Tersimpan otomatis setelah berhenti mengetik.";
                            color: Theme.text-3;
                            font-size: 13px;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Kolom kanan, mode tayang: pratinjau, tayang, dan kontrol.
                if !root.editing: Rectangle {
                    width: 360px;
                    background: Theme.panel;
                    ScrollView {
                        content-width: self.visible-width;
                        content-height: controls.preferred-height;
                        controls := VerticalLayout {
                            width: parent.width;
                            padding: 18px;
                            spacing: 10px;
                            SectionTitle {
                                text: "Pratinjau";
                                detail: root.preview-meta;
                                padding-left: 0px;
                                padding-right: 0px;
                            }
                            Screen {
                                height: self.width * 9 / 16;
                                tile: root.preview;
                                has-slide: root.has-preview;
                                bg-index: root.bg-index;
                                picture: root.bg-picture;
                                has-picture: root.has-bg-picture;
                                ring: Theme.accent;
                                empty-text: "Pilih slide untuk dipratinjau";
                            }
                            Rectangle {
                                height: 2px;
                            }
                            Btn {
                                kind: "primary";
                                text: "Tayangkan";
                                icon: Icons.play;
                                icon-filled: true;
                                kbd: "F5";
                                height: 52px;
                                font-size: 16px;
                                clicked => {
                                    keys.focus();
                                    root.go-live();
                                }
                            }
                            Rectangle {
                                height: 9px;
                                Rectangle {
                                    y: 4px;
                                    height: 1px;
                                    background: Theme.line;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 9px;
                                        height: 9px;
                                        border-radius: 4.5px;
                                        background: Theme.live;
                                    }
                                }
                                Text {
                                    text: "Tayang";
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.live-meta;
                                    color: Theme.text-3;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            Screen {
                                height: self.width * 9 / 16;
                                tile: root.live;
                                has-slide: root.has-live;
                                dark: root.blackout;
                                bg-index: root.bg-index;
                                picture: root.bg-picture;
                                has-picture: root.has-bg-picture;
                                ring: Theme.live;
                                empty-text: "Belum ada yang tayang";
                            }
                            Rectangle {
                                height: 2px;
                            }
                            GridLayout {
                                spacing: 8px;
                                Row {
                                    Btn {
                                        text: "Sebelumnya";
                                        font-size: 13px;
                                        pad: 10px;
                                        icon: Icons.left;
                                        clicked => {
                                            keys.focus();
                                            root.navigate(false);
                                        }
                                    }
                                    Btn {
                                        text: "Berikutnya";
                                        font-size: 13px;
                                        pad: 10px;
                                        icon: Icons.right;
                                        clicked => {
                                            keys.focus();
                                            root.navigate(true);
                                        }
                                    }
                                }
                                Row {
                                    Btn {
                                        text: root.blackout ? "Pulihkan" : "Gelapkan";
                                        font-size: 13px;
                                        pad: 10px;
                                        icon: root.blackout ? Icons.sun : Icons.moon;
                                        kbd: "F6";
                                        on: root.blackout;
                                        clicked => {
                                            keys.focus();
                                            root.toggle-blackout();
                                        }
                                    }
                                    Btn {
                                        text: root.fullscreen ? "Jendela" : "Layar penuh";
                                        font-size: 13px;
                                        pad: 10px;
                                        icon: root.fullscreen ? Icons.minimize : Icons.maximize;
                                        kbd: "F11";
                                        clicked => {
                                            keys.focus();
                                            root.toggle-fullscreen();
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 4px;
                            }
                            Text {
                                text: "Latar layar";
                                color: Theme.text-2;
                                font-size: 13px;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                for name[i] in Theme.slide-names: Swatch {
                                    index: i;
                                    on: i == root.bg-index && !root.has-bg-picture;
                                    clicked => {
                                        root.background-changed(i);
                                    }
                                }
                                PictureSwatch {
                                    picture: root.bg-picture;
                                    on: root.has-bg-picture;
                                    clicked => {
                                        root.show-backgrounds();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: 0;
                        width: 1px;
                        background: Theme.line;
                    }
                }

                // Kolom kanan, mode edit: hasil slide.
                if root.editing: Rectangle {
                    width: 360px;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        SectionTitle {
                            text: "Hasil slide";
                            detail: root.editor-slides.length + " slide";
                            padding-left: 0px;
                            padding-right: 0px;
                        }
                        if root.editor-slides.length == 0: Text {
                            text: "Belum ada slide. Tulis teks di kolom Isi.";
                            color: Theme.text-3;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        results := ScrollView {
                            vertical-stretch: 1;
                            property <length> tile-w: (self.visible-width - 12px) / 2;
                            property <length> tile-h: self.tile-w * 9 / 16 + 22px;
                            content-width: self.visible-width;
                            content-height: Math.ceil(root.editor-slides.length / 2) * (self.tile-h + 12px);
                            for tile[i] in root.editor-slides: Rectangle {
                                x: Math.mod(i, 2) * (results.tile-w + 12px);
                                y: Math.floor(i / 2) * (results.tile-h + 12px);
                                width: results.tile-w;
                                height: results.tile-h;
                                Rectangle {
                                    y: 0;
                                    height: parent.width * 9 / 16;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #2A303C;
                                    clip: true;
                                    background: Theme.slide-bg[root.bg-index];
                                    if root.has-bg-picture: PictureFill {
                                        width: parent.width;
                                        height: parent.height;
                                        picture: root.bg-picture;
                                    }
                                    SlideText {
                                        width: parent.width;
                                        height: parent.height;
                                        text: tile.text;
                                        lines: tile.lines;
                                        chars: tile.chars;
                                        ink: root.has-bg-picture ? Theme.picture-ink : Theme.slide-ink[root.bg-index];
                                        outline: root.has-bg-picture;
                                    }
                                }
                                Text {
                                    y: parent.width * 9 / 16 + 4px;
                                    text: i + 1;
                                    color: #C5CBD6;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }
                        }
                        Btn {
                            kind: "primary";
                            text: "Tambah ke susunan";
                            icon: Icons.plus;
                            height: 50px;
                            font-size: 15px;
                            clicked => {
                                root.add-current-to-service();
                            }
                        }
                        Btn {
                            kind: "danger";
                            text: "Hapus materi";
                            icon: Icons.trash;
                            clicked => {
                                root.delete-current();
                            }
                        }
                    }
                    Rectangle {
                        x: 0;
                        width: 1px;
                        background: Theme.line;
                    }
                }
            }

            // Bilah bawah: status, tombol cepat, dan pembaruan.
            Rectangle {
                height: 36px;
                background: Theme.bar;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 12px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 7px;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                svg: root.status-ok ? Icons.check : Icons.info;
                                color: root.status-ok ? Theme.ok : Theme.accent;
                                width: 14px;
                                height: 14px;
                            }
                        }
                        Text {
                            text: root.status;
                            color: root.status-ok ? Theme.text-3 : Theme.text-2;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Kbd {
                                text: "PgDn";
                            }
                        }
                        Text {
                            text: "berikutnya";
                            color: Theme.text-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            Kbd {
                                text: "PgUp";
                            }
                        }
                        Text {
                            text: "sebelumnya";
                            color: Theme.text-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            Kbd {
                                text: "Esc";
                            }
                        }
                        Text {
                            text: "keluar layar penuh";
                            color: Theme.text-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    if root.update-version != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            width: update-label.preferred-width + 44px;
                            border-radius: 14px;
                            background: update-touch.has-hover ? #3A3018 : Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.accent;
                            accessible-role: button;
                            accessible-label: update-label.text;
                            accessible-action-default => {
                                root.update-now();
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        svg: Icons.refresh;
                                        color: #F7D58A;
                                        width: 14px;
                                        height: 14px;
                                    }
                                }
                                update-label := Text {
                                    text: "Perbarui ke " + root.update-version;
                                    color: #F7D58A;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            update-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.update-now();
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.picking-profile: ProfileScreen {
            width: parent.width;
            height: parent.height;
            profiles: root.profiles;
            current-name: root.profile-name;
            form <=> root.profile-form;
            form-name <=> root.profile-form-name;
            form-target <=> root.profile-form-target;
            form-error <=> root.profile-form-error;
            choose(id) => {
                root.choose-profile(id);
            }
            close => {
                root.close-profiles();
            }
            submit => {
                root.submit-profile-form();
            }
            remove(id) => {
                root.delete-profile(id);
            }
        }
    }
}

// Jendela yang dilihat jemaat (proyektor / layar kedua).
export component OutputWindow inherits Window {
    in property <SlideTile> tile;
    in property <bool> has-slide;
    in property <bool> dark;
    in property <int> bg-index;
    in property <image> picture;
    in property <bool> has-picture;
    in property <bool> fullscreen;
    callback go-live();
    callback navigate(bool);
    callback toggle-blackout();
    callback toggle-fullscreen();
    callback escape();

    title: "Lentera · Proyektor";
    preferred-width: 960px;
    preferred-height: 540px;
    background: root.dark ? #000000 : Theme.slide-bg[root.bg-index];

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.F5 {
                root.go-live();
                return accept;
            }
            if event.text == Key.F6 {
                root.toggle-blackout();
                return accept;
            }
            if event.text == Key.F11 {
                root.toggle-fullscreen();
                return accept;
            }
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            if event.text == Key.PageDown || event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == " " {
                root.navigate(true);
                return accept;
            }
            if event.text == Key.PageUp || event.text == Key.LeftArrow || event.text == Key.UpArrow {
                root.navigate(false);
                return accept;
            }
            reject
        }
        if root.has-picture && !root.dark: PictureFill {
            width: parent.width;
            height: parent.height;
            picture: root.picture;
        }
        if root.has-slide && !root.dark: SlideText {
            width: parent.width;
            height: parent.height;
            text: root.tile.text;
            lines: root.tile.lines;
            chars: root.tile.chars;
            ink: root.has-picture ? Theme.picture-ink : Theme.slide-ink[root.bg-index];
            outline: root.has-picture;
        }
        TouchArea {
            mouse-cursor: root.fullscreen ? MouseCursor.none : MouseCursor.default;
            double-clicked => {
                root.toggle-fullscreen();
            }
        }
    }
}
