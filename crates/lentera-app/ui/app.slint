// Tampilan Lentera: jendela operator (MainWindow) dan jendela proyektor
// (OutputWindow). Logika dan data ada di Rust (src/main.rs).

import { AboutSlint, TextEdit, LineEdit, ComboBox, ScrollView, ListView } from "std-widgets.slint";

export struct LibraryRow {
    id: int,
    title: string,
    meta: string,
    song: bool,
    // Sudah ada di susunan ibadah.
    in-service: bool,
}

export struct ServiceRow {
    id: int,
    title: string,
    meta: string,
    song: bool,
}

export struct SlideTile {
    text: string,
    first: string,
    lines: int,
    chars: int,
    // Referensi ayat di bawah teks, misalnya "Yohanes 3:16 (TB)". Hanya diisi
    // untuk slide yang tayang.
    caption: string,
    // Materi ayat: hurufnya sedikit lebih tipis dari lirik.
    verse: bool,
}

// Satu ayat di daftar pasal tab Alkitab.
export struct VerseRow {
    number: string,
    text: string,
    // Termasuk referensi yang sedang dipilih.
    picked: bool,
}

// Satu referensi di "Terakhir dibuka".
export struct HistoryRow {
    label: string,
    // Misalnya "3 ayat".
    detail: string,
}

export struct ProfileCard {
    id: string,
    name: string,
    initial: string,
    detail: string,
    // Indeks warna di Theme.avatar.
    tone: int,
    current: bool,
}

// Satu gambar atau video di daftar latar. Untuk video, `picture` adalah
// gambar kecil dari gambar diamnya.
export struct BackgroundTile {
    name: string,
    label: string,
    picture: image,
    on: bool,
    video: bool,
}

export global Theme {
    out property <color> bg: #0F1115;
    out property <color> bar: #12151B;
    out property <color> panel: #13161C;
    out property <color> raised: #181C24;
    out property <color> hover: #1C2029;
    out property <color> active: #1F2430;
    out property <color> active-border: #2F3646;
    out property <color> line: #222731;
    out property <color> border: #2C3240;
    out property <color> text: #E9ECF1;
    out property <color> text-2: #A3ABB9;
    out property <color> text-3: #8B94A5;
    out property <color> num: #6F7889;
    out property <color> accent: #F2B441;
    out property <color> accent-soft: #2B2414;
    out property <color> on-accent: #1A1204;
    out property <color> live: #E5484D;
    out property <color> live-badge: #D93036;
    out property <color> live-soft: #2A1416;
    out property <color> verse: #8DB4FF;
    out property <color> verse-soft: #152238;
    out property <color> ok: #3FCB7E;
    out property <color> ok-soft: #11251A;
    out property <color> ok-border: #1F4A33;
    out property <color> danger: #FF9EA2;
    // Latar layar proyektor, urutannya sama dengan `Library::background`.
    out property <[color]> slide-bg: [#0B0D12, #0E1C3A, #F3EFE6];
    out property <[color]> slide-ink: [#F5F7FA, #F5F7FA, #1B1A17];
    out property <[string]> slide-names: ["Gelap", "Biru malam", "Terang"];
    // Gambar latar digelapkan sedikit dan teks diberi garis tepi gelap, supaya
    // tetap terbaca di atas bagian gambar yang terang.
    out property <color> picture-dim: #00000059;
    out property <color> picture-ink: #FFFFFF;
    out property <color> picture-outline: #000000B8;
    // Referensi ayat di bawah teks, per latar umum dan di atas gambar.
    out property <[color]> slide-caption: [#AEB7C6, #C9D6F2, #5C5850];
    out property <color> picture-caption: #FFFFFFE6;
    // Warna lingkaran inisial profil. Jumlahnya sama dengan PROFILE_TONES di main.rs.
    out property <[color]> avatar: [#F2B441, #8DB4FF, #3FCB7E, #FF9EA2, #C9A7FF, #6FD6CF];
}

