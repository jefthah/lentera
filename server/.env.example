# Server membaca variabel environment langsung; berkas ini hanya contoh.
# Untuk APP_ENV=local, DATABASE_URL boleh dikosongkan dan otomatis memakai Postgres dari compose.dev.yml.
APP_ENV=local
HTTP_ADDR=127.0.0.1:8310
DATABASE_URL=postgres://lentera:lentera-dev@127.0.0.1:54330/lentera?sslmode=disable

# Rahasia HMAC kode masuk, minimal 32 karakter. Di local boleh kosong (memakai rahasia pengembangan tetap).
# Buat dengan: openssl rand -hex 32
LOGIN_CODE_SECRET=
# Kosong = kode masuk hanya ditulis ke log server (local/staging). Wajib di production.
RESEND_API_KEY=
# Wajib jika RESEND_API_KEY diisi. Domain pengirim harus sudah diverifikasi di Resend.
MAIL_FROM=

# Hanya untuk tes (go test ./...). Tes yang butuh database dilewati jika kosong.
# Setiap tes membuat dan menghapus database sementara sendiri.
TEST_DATABASE_URL=postgres://lentera:lentera-dev@127.0.0.1:54330/lentera?sslmode=disable
