    out property <string> play: "M7 4l13 8-13 8z";
    out property <string> chevron: "M6 9l6 6 6-6";
    out property <string> image: "M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M4 16l5-5 4 4 2-2 5 5 M15.5 8.5h.01";
